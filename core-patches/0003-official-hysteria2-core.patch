+func TestProtectedFactoryUsesSingBoxResolutionAndPacketDialer(t *testing.T) {
+	packetConn := &stubPacketConn{}
+	dialer := &stubDialer{packetConn: packetConn, address: netip.MustParseAddr("192.0.2.10")}
+	factory, serverAddr, err := newProtectedConnFactory(context.Background(), dialer, option.Hysteria2OutboundOptions{
+		ServerOptions: option.ServerOptions{Server: "synthetic.example", ServerPort: 443},
+		ServerPorts:   badoption.Listable[string]{"443", "8443"},
+		HopInterval:   badoption.Duration(5 * time.Second),
+		Obfs:          &option.Hysteria2Obfs{Type: "gecko", Password: "synthetic"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if dialer.resolveCalls != 1 || serverAddr.String() != "192.0.2.10:443,8443" {
+		t.Fatalf("resolution did not stay in sing-box: calls=%d addr=%s", dialer.resolveCalls, serverAddr)
+	}
+	conn, err := factory.New(serverAddr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
