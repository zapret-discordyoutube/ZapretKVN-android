+type protectedConnFactory struct {
+	dialer      N.Dialer
+	destination M.Socksaddr
+	firstConn   net.PacketConn
+	hopAddr     *udphop.UDPHopAddr
+	hopInterval time.Duration
+	obfs        *option.Hysteria2Obfs
+	access      sync.Mutex
+}
+
+func newProtectedConnFactory(ctx context.Context, outboundDialer N.Dialer, options option.Hysteria2OutboundOptions) (*protectedConnFactory, net.Addr, error) {
+	destination := options.ServerOptions.Build()
+	var (
+		conn net.PacketConn
+		ip   netip.Addr
+		err  error
+	)
+	if destination.IsDomain() {
+		resolvedDialer, ok := outboundDialer.(dialer.PacketDialerWithDestination)
+		if !ok {
+			return nil, nil, E.New("protected Hysteria2 dialer cannot expose resolved server address")
+		}
+		conn, ip, err = resolvedDialer.ListenPacketWithDestination(ctx, destination)
+	} else {
+		conn, err = outboundDialer.ListenPacket(ctx, destination)
+		ip = destination.Addr
+	}
+	if err != nil {
+		return nil, nil, E.Cause(err, "open protected Hysteria2 packet socket")
+	}
+	factory := &protectedConnFactory{
+		dialer:      outboundDialer,
+		destination: M.SocksaddrFrom(ip, destination.Port),
+		firstConn:   conn,
+		hopInterval: time.Duration(options.HopInterval),
+		obfs:        options.Obfs,
+	}
+	if len(options.ServerPorts) == 0 {
+		return factory, factory.destination.UDPAddr(), nil
+	}
+	portUnion := normalizePortUnion(options.ServerPorts)
+	hopAddr, err := udphop.ResolveUDPHopAddr(net.JoinHostPort(ip.String(), portUnion))
+	if err != nil {
+		_ = conn.Close()
+		return nil, nil, E.Cause(err, "parse Hysteria2 server_ports")
+	}
+	factory.hopAddr = hopAddr
+	return factory, hopAddr, nil
+}
+
+func normalizePortUnion(ports badoption.Listable[string]) string {
+	normalized := make([]string, 0, len(ports))
+	for _, value := range ports {
+		normalized = append(normalized, strings.ReplaceAll(strings.TrimSpace(value), ":", "-"))
+	}
+	return strings.Join(normalized, ",")
+}
+
+func (f *protectedConnFactory) New(net.Addr) (net.PacketConn, error) {
+	listen := func() (net.PacketConn, error) {
+		f.access.Lock()
+		if f.firstConn != nil {
+			conn := f.firstConn
+			f.firstConn = nil
+			f.access.Unlock()
+			return conn, nil
+		}
+		f.access.Unlock()
+		return f.dialer.ListenPacket(context.Background(), f.destination)
+	}
+	var (
+		conn net.PacketConn
+		err  error
+	)
+	if f.hopAddr != nil {
+		interval := udphop.HopIntervalConfig{Min: f.hopInterval, Max: f.hopInterval}
+		conn, err = udphop.NewUDPHopPacketConn(f.hopAddr, interval, listen)
+	} else {
+		conn, err = listen()
+	}
+	if err != nil {
+		return nil, err
+	}
+	if f.obfs == nil || f.obfs.Type == "" || f.obfs.Type == "none" || f.obfs.Type == "plain" {
+		return conn, nil
+	}
+	switch strings.ToLower(f.obfs.Type) {
+	case "salamander":
+		return hyobfs.WrapPacketConnSalamander(conn, []byte(f.obfs.Password))
+	case "gecko":
+		return hyobfs.WrapPacketConnGecko(conn, hyobfs.GeckoOptions{
+			Password:      []byte(f.obfs.Password),
+			MinPacketSize: f.obfs.MinPacketSize,
+			MaxPacketSize: f.obfs.MaxPacketSize,
+		})
+	default:
+		_ = conn.Close()
+		return nil, E.New("unknown obfs type: ", f.obfs.Type)
+	}
 }
+
+func (f *protectedConnFactory) Close() error {
+	f.access.Lock()
+	defer f.access.Unlock()
+	if f.firstConn == nil {
+		return nil
+	}
+	err := f.firstConn.Close()
+	f.firstConn = nil
+	return err
+}
+
+func validateObfs(obfsOptions *option.Hysteria2Obfs) error {
+	if obfsOptions == nil || obfsOptions.Type == "" || obfsOptions.Type == "none" || obfsOptions.Type == "plain" {
+		return nil
+	}
+	switch strings.ToLower(obfsOptions.Type) {
+	case "salamander", "gecko":
+		if obfsOptions.Password == "" {
+			return E.New("missing obfs password")
+		}
+	default:
+		return E.New("unknown obfs type: ", obfsOptions.Type)
+	}
+	if obfsOptions.Type != "gecko" && (obfsOptions.MinPacketSize != 0 || obfsOptions.MaxPacketSize != 0) {
+		return E.New("min_packet_size/max_packet_size are only valid for gecko")
+	}
+	return nil
+}
+
+func upstreamTLSConfig(ctx context.Context, options option.Hysteria2OutboundOptions) (hyclient.TLSConfig, error) {
+	tlsOptions := options.TLS
+	pin, err := certificatePin(options.CertificateSHA256)
+	if err != nil {
+		return hyclient.TLSConfig{}, err
+	}
+	config := hyclient.TLSConfig{
+		ServerName:         tlsOptions.ServerName,
+		InsecureSkipVerify: tlsOptions.Insecure,
+		RootCAs:            adapter.RootPoolFromContext(ctx),
+	}
+	if len(pin) > 0 {
+		config.VerifyPeerCertificate = func(rawCerts [][]byte, _ [][]*x509.Certificate) error {
+			if len(rawCerts) == 0 {
+				return E.New("no server certificate for certificate_sha256")
+			}
+			digest := sha256.Sum256(rawCerts[0])
+			if subtle.ConstantTimeCompare(digest[:], pin) != 1 {
+				return E.New("server certificate SHA-256 mismatch")
+			}
+			return nil
+		}
+	}
+	if tlsOptions.ECH != nil && tlsOptions.ECH.Enabled {
+		if len(tlsOptions.ECH.Config) == 0 {
+			return hyclient.TLSConfig{}, E.New("Hysteria2 ECH requires tls.ech.config")
+		}
+		block, rest := pem.Decode([]byte(strings.Join(tlsOptions.ECH.Config, "\n")))
+		if block == nil || block.Type != "ECH CONFIGS" || len(rest) != 0 {
+			return hyclient.TLSConfig{}, E.New("invalid Hysteria2 ECH configs PEM")
+		}
+		config.ECHConfigList = block.Bytes
+	}
+	return config, nil
+}
+
+func certificatePin(value string) ([]byte, error) {
+	normalized := strings.NewReplacer(":", "", "-", "").Replace(strings.ToLower(strings.TrimSpace(value)))
+	if normalized == "" {
+		return nil, nil
+	}
+	decoded, err := hex.DecodeString(normalized)
+	if err != nil || len(decoded) != sha256.Size {
+		return nil, E.New("certificate_sha256 must contain exactly 32 SHA-256 bytes")
+	}
+	return decoded, nil
+}
+
+type hyPacketConn struct {
+	conn hyclient.HyUDPConn
+}
+
+func (c *hyPacketConn) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	payload, address, err := c.conn.Receive()
+	if err != nil {
+		return 0, nil, err
+	}
+	n := copy(buffer, payload)
+	return n, M.ParseSocksaddr(address), nil
+}
+
+func (c *hyPacketConn) WriteTo(buffer []byte, address net.Addr) (int, error) {
+	err := c.conn.Send(buffer, M.SocksaddrFromNet(address).String())
+	if err != nil {
+		return 0, err
+	}
+	return len(buffer), nil
+}
+
+func (c *hyPacketConn) Close() error                     { return c.conn.Close() }
+func (c *hyPacketConn) LocalAddr() net.Addr              { return M.Socksaddr{} }
+func (c *hyPacketConn) SetDeadline(time.Time) error      { return nil }
+func (c *hyPacketConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *hyPacketConn) SetWriteDeadline(time.Time) error { return nil }
