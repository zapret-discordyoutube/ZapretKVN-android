+func TestOfficialGeckoClientAgainstUpstreamServer(t *testing.T) {
+	certificate := syntheticCertificate(t)
+	serverSocket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverConn, err := obfs.WrapPacketConnGecko(serverSocket, obfs.GeckoOptions{Password: []byte("synthetic-gecko")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := hyserver.NewServer(&hyserver.Config{
+		TLSConfig:     hyserver.TLSConfig{Certificates: []tls.Certificate{certificate}},
+		Conn:          serverConn,
+		Authenticator: allowSyntheticAuth{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	go func() { _ = server.Serve() }()
+
+	echo, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		conn, acceptErr := echo.Accept()
+		if acceptErr == nil {
+			_, _ = io.Copy(conn, conn)
+			_ = conn.Close()
+		}
+	}()
+
+	serverAddr := serverSocket.LocalAddr().(*net.UDPAddr)
+	factory, destination, err := newProtectedConnFactory(context.Background(), realPacketDialer{}, option.Hysteria2OutboundOptions{
+		ServerOptions: option.ServerOptions{Server: serverAddr.IP.String(), ServerPort: uint16(serverAddr.Port)},
+		Obfs:          &option.Hysteria2Obfs{Type: "gecko", Password: "synthetic-gecko"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, _, err := hyclient.NewClient(&hyclient.Config{
+		ConnFactory: factory,
+		ServerAddr:  destination,
+		Auth:        "synthetic-auth",
+		TLSConfig:   hyclient.TLSConfig{InsecureSkipVerify: true},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	conn, err := client.TCP(echo.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	payload := []byte("synthetic upstream gecko payload")
+	if _, err := conn.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	received := make([]byte, len(payload))
+	if _, err := io.ReadFull(conn, received); err != nil {
+		t.Fatal(err)
+	}
+	if string(received) != string(payload) {
+		t.Fatalf("unexpected echo %q", received)
+	}
+}
