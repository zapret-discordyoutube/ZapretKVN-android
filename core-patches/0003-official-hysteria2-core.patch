+func validateObfs(obfsOptions *option.Hysteria2Obfs) error {
+	if obfsOptions == nil {
+		return nil
+	}
+	typeName := strings.ToLower(strings.TrimSpace(obfsOptions.Type))
+	if typeName == "" || typeName == "none" || typeName == "plain" {
+		if obfsOptions.MinPacketSize != 0 || obfsOptions.MaxPacketSize != 0 {
+			return E.New("min_packet_size/max_packet_size are only valid for gecko")
+		}
+		return nil
+	}
+	if typeName != "salamander" && typeName != "gecko" {
+		return E.New("unknown obfs type: ", obfsOptions.Type)
+	}
+	if obfsOptions.Password == "" {
+		return E.New("missing obfs password")
+	}
+	if obfsOptions.MinPacketSize < 0 || obfsOptions.MaxPacketSize < 0 || obfsOptions.MinPacketSize > obfsOptions.MaxPacketSize {
+		return E.New("invalid Hysteria2 packet size range")
+	}
+	if obfsOptions.MaxPacketSize > 2048 {
+		return E.New("invalid Hysteria2 packet size")
+	}
+	if typeName != "gecko" && (obfsOptions.MinPacketSize != 0 || obfsOptions.MaxPacketSize != 0) {
+		return E.New("min_packet_size/max_packet_size are only valid for gecko")
+	}
+	return nil
+}
