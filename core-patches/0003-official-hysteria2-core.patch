+package link
+
+import (
+	"encoding/base64"
+	"testing"
+	"time"
+)
+
+func TestParseHysteria2URIColonPortUnion(t *testing.T) {
+	for _, uri := range []string{
+		"hy2://secret@example.com:443,20000:20002",
+		"hysteria2://secret@[2001:db8::1]:443,20000:20002",
+	} {
+		parsed, err := parseHysteria2URI(uri)
+		if err != nil {
+			t.Fatalf("parse %q: %v", uri, err)
+		}
+		if parsed.firstPort != 443 || len(parsed.serverPorts) != 2 || parsed.serverPorts[1] != "20000-20002" {
+			t.Fatalf("unexpected port union for %q: first=%d ports=%v", uri, parsed.firstPort, parsed.serverPorts)
+		}
+	}
+}
+
+func TestParseHysteria2URITransportContract(t *testing.T) {
+	ech := base64.RawURLEncoding.EncodeToString([]byte{0, 1, 2, 3})
+	parsed, err := parseHysteria2URI(
+		"hy2://p%40ss@example.com:8443?" +
+			"sni=edge.example&insecure=1&pinSHA256=" +
+			"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f&" +
+			"obfs=gecko&obfs-password=cover&min-packet-size=900&max-packet-size=1200&" +
+			"up=20&down=80&hop-interval=15s&ech=" + ech + "&vendor=preserved-by-app#name",
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed.password != "p@ss" || parsed.serverName != "edge.example" || !parsed.insecure {
+		t.Fatalf("authentication/TLS fields were not parsed: %+v", parsed)
+	}
+	if parsed.obfs == nil || parsed.obfs.Type != "gecko" || parsed.obfs.Password != "cover" ||
+		parsed.obfs.GeckoOptions.MinPacketSize != 900 || parsed.obfs.GeckoOptions.MaxPacketSize != 1200 {
+		t.Fatalf("Gecko fields were not parsed: %+v", parsed.obfs)
+	}
+	if parsed.upMbps != 20 || parsed.downMbps != 80 || parsed.hopInterval != 15*time.Second || parsed.echPEM == "" {
+		t.Fatalf("transport fields were not parsed: %+v", parsed)
+	}
+}
+
+func TestParseHysteria2URIExactQueryDialect(t *testing.T) {
+	parsed, err := parseHysteria2URI(
+		"hy2://edge.example:443,20000:20002?auth=user+pass&up=2+Gbps&" +
+			"down=2000000+bps&hop-interval=15&obfs=gecko&obfs-password=cover+key&" +
+			"min-packet-size=64&max-packet-size=128",
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed.password != "user pass" || parsed.upMbps != 2000 || parsed.downMbps != 2 ||
+		parsed.hopInterval != 15*time.Second || parsed.serverPorts[1] != "20000-20002" {
+		t.Fatalf("query dialect fields were not normalized: %+v", parsed)
+	}
+	if parsed.obfs == nil || parsed.obfs.Password != "cover key" ||
+		parsed.obfs.GeckoOptions.MinPacketSize != 64 || parsed.obfs.GeckoOptions.MaxPacketSize != 128 {
+		t.Fatalf("query Gecko fields were not normalized: %+v", parsed.obfs)
+	}
+}
+
+func TestParseHysteria2URIRejectsUnbracketedIPv6(t *testing.T) {
+	if _, err := parseHysteria2URI("hy2://secret@2001:db8::1"); err == nil {
+		t.Fatal("unbracketed IPv6 authority accepted")
+	}
+}
+
+func TestParseHysteria2URIRejectsInsecureWithoutPin(t *testing.T) {
+	if _, err := parseHysteria2URI("hy2://secret@example.com:443?insecure=1"); err == nil {
+		t.Fatal("insecure URI without certificate pin accepted")
+	}
+}
+
+func TestParseHysteria2URIRejectsDuplicateKnownParameters(t *testing.T) {
+	for _, uri := range []string{
+		"hy2://secret@example.com:443?sni=one.example&sni=two.example",
+		"hy2://secret@example.com:443?sni=one.example&peer=two.example",
+	} {
+		if _, err := parseHysteria2URI(uri); err == nil {
+			t.Fatalf("duplicate known parameter accepted: %s", uri)
+		}
+	}
+}
+
+func TestParseHysteria2URIRejectsControlCharacters(t *testing.T) {
+	for _, uri := range []string{
+		"hy2://secret@example.com:443?auth=bad%0Avalue",
+		"hy2://secret@example.com:443#bad%0Dname",
+	} {
+		if _, err := parseHysteria2URI(uri); err == nil {
+			t.Fatalf("control character accepted: %s", uri)
+		}
+	}
+}
