+func TestApplyHysteria2URIUsesTransportFieldsAndPreservesNativeTLSMaterial(t *testing.T) {
+	options := option.Hysteria2OutboundOptions{
+		URI: "hy2://p%40ss@example.com:443,20000:20002?sni=edge.example&" +
+			"obfs=salamander&obfs-password=cover&up=20&down=80&hop-interval=15s&vendor=ignored",
+		OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{
+			Enabled:               true,
+			CertificatePath:       "/native/ca.pem",
+			ClientCertificatePath: "/native/client.pem",
+			ClientKeyPath:         "/native/client.key",
+		}},
+	}
+	parsed, err := applyHysteria2URI(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed.URI != "" || parsed.Server != "example.com" || parsed.ServerPort != 443 || parsed.Password != "p@ss" {
+		t.Fatalf("URI transport fields were not applied: %+v", parsed)
+	}
+	if !reflect.DeepEqual(parsed.ServerPorts, badoption.Listable[string]{"443", "20000-20002"}) ||
+		parsed.Obfs == nil || parsed.Obfs.Type != "salamander" || parsed.Obfs.Password != "cover" ||
+		parsed.UpMbps != 20 || parsed.DownMbps != 80 || time.Duration(parsed.HopInterval) != 15*time.Second {
+		t.Fatalf("URI transport options were not applied: %+v", parsed)
+	}
+	if parsed.TLS == nil || parsed.TLS.ServerName != "edge.example" ||
+		parsed.TLS.CertificatePath != "/native/ca.pem" ||
+		parsed.TLS.ClientCertificatePath != "/native/client.pem" || parsed.TLS.ClientKeyPath != "/native/client.key" {
+		t.Fatalf("native TLS material was not preserved: %+v", parsed.TLS)
+	}
+}
