+type hysteria2URI struct {
+	host              string
+	firstPort         uint16
+	serverPorts       badoption.Listable[string]
+	password          string
+	serverName        string
+	insecure          bool
+	upMbps            int
+	downMbps          int
+	hopInterval       time.Duration
+	obfs              *option.Hysteria2Obfs
+	certificateSHA256 string
+	echPEM            string
+	fragment          string
+}
+
+// parseHysteria2URI deliberately does not use URL.Port: official Hysteria2
+// links allow comma-separated ports and colon-separated ranges in authority.
+// Unknown query parameters are ignored and never included in errors/logs.
+func parseHysteria2URI(link string) (hysteria2URI, error) {
+	var result hysteria2URI
+	schemeEnd := strings.Index(link, "://")
+	if schemeEnd <= 0 || !strings.EqualFold(link[:schemeEnd], "hy2") && !strings.EqualFold(link[:schemeEnd], "hysteria2") {
+		return result, fmt.Errorf("invalid Hysteria2 URI scheme")
+	}
+	body := link[schemeEnd+3:]
+	fragment := ""
+	if hash := strings.IndexByte(body, '#'); hash >= 0 {
+		fragment, _ = url.PathUnescape(body[hash+1:])
+		body = body[:hash]
+	}
+	queryText := ""
+	if question := strings.IndexByte(body, '?'); question >= 0 {
+		queryText = body[question+1:]
+		body = body[:question]
+	}
+	authority := strings.SplitN(body, "/", 2)[0]
+	if authority == "" {
+		return result, fmt.Errorf("Hysteria2 URI has no server")
+	}
+	userinfo := ""
+	if at := strings.LastIndexByte(authority, '@'); at >= 0 {
+		userinfo = authority[:at]
+		authority = authority[at+1:]
+	}
+	host, portText, err := splitHysteria2HostPort(authority)
+	if err != nil {
+		return result, err
+	}
+	host, err = url.PathUnescape(host)
+	if err != nil || strings.TrimSpace(host) == "" {
+		return result, fmt.Errorf("Hysteria2 URI has invalid server")
+	}
+	firstPort, serverPorts, err := parseHysteria2Ports(portText)
+	if err != nil {
+		return result, err
+	}
+	password, err := url.PathUnescape(userinfo)
+	if err != nil {
+		return result, fmt.Errorf("Hysteria2 URI has invalid authentication")
+	}
+	query, err := parseHysteria2Query(queryText)
+	if err != nil {
+		return result, err
+	}
+	if password == "" {
+		password = query["auth"]
+	}
+	if password == "" {
+		return result, fmt.Errorf("Hysteria2 URI has no authentication password")
+	}
+	serverName := query["sni"]
+	if serverName == "" {
+		serverName = host
+	}
+	result = hysteria2URI{
+		host:        host,
+		firstPort:   firstPort,
+		serverPorts: serverPorts,
+		password:    password,
+		serverName:  serverName,
+		insecure:    hysteria2Bool(query["insecure"]),
+		fragment:    fragment,
+	}
+	if value := query["up"]; value != "" {
+		result.upMbps, err = parseHysteria2Mbps(value)
+		if err != nil {
+			return hysteria2URI{}, fmt.Errorf("invalid Hysteria2 up bandwidth")
+		}
+	}
+	if value := query["down"]; value != "" {
+		result.downMbps, err = parseHysteria2Mbps(value)
+		if err != nil {
+			return hysteria2URI{}, fmt.Errorf("invalid Hysteria2 down bandwidth")
+		}
+	}
+	if value := query["hopinterval"]; value != "" {
+		result.hopInterval, err = time.ParseDuration(value)
+		if err != nil {
+			if seconds, numberErr := strconv.Atoi(value); numberErr == nil {
+				result.hopInterval = time.Duration(seconds) * time.Second
+			} else {
+				return hysteria2URI{}, fmt.Errorf("invalid Hysteria2 hop interval")
+			}
+		}
+	}
+	if value := query["pinsha256"]; value != "" {
+		result.certificateSHA256, err = normalizeHysteria2Pin(value)
+		if err != nil {
+			return hysteria2URI{}, err
+		}
+	}
+	obfsType := strings.ToLower(strings.TrimSpace(query["obfs"]))
+	if obfsType != "" && obfsType != "none" && obfsType != "plain" {
+		if obfsType != "salamander" && obfsType != "gecko" {
+			return hysteria2URI{}, fmt.Errorf("unsupported Hysteria2 obfs")
+		}
+		obfsPassword := query["obfspassword"]
+		if obfsPassword == "" {
+			return hysteria2URI{}, fmt.Errorf("Hysteria2 obfs password is required")
+		}
+		result.obfs = &option.Hysteria2Obfs{Type: obfsType, Password: obfsPassword}
+	}
+	minPacket, maxPacket, packetErr := parseHysteria2PacketSizes(query)
+	if packetErr != nil {
+		return hysteria2URI{}, packetErr
+	}
+	if minPacket != 0 || maxPacket != 0 {
+		if result.obfs == nil || result.obfs.Type != "gecko" {
+			return hysteria2URI{}, fmt.Errorf("Hysteria2 packet sizes require Gecko obfs")
+		}
+		result.obfs.MinPacketSize = minPacket
+		result.obfs.MaxPacketSize = maxPacket
+	}
+	if value := query["ech"]; value != "" {
+		result.echPEM, err = decodeHysteria2ECH(value)
+		if err != nil {
+			return hysteria2URI{}, err
+		}
+	}
+	return result, nil
+}
+
+func splitHysteria2HostPort(authority string) (string, string, error) {
+	if strings.HasPrefix(authority, "[") {
+		closeBracket := strings.IndexByte(authority, ']')
+		if closeBracket <= 1 {
+			return "", "", fmt.Errorf("Hysteria2 URI has invalid IPv6 server")
+		}
+		rest := authority[closeBracket+1:]
+		if rest == "" {
+			return authority[1:closeBracket], "443", nil
+		}
+		if !strings.HasPrefix(rest, ":") || len(rest) == 1 {
+			return "", "", fmt.Errorf("Hysteria2 URI has invalid IPv6 port")
+		}
+		if _, _, err := parseHysteria2Ports(rest[1:]); err != nil {
+			return "", "", fmt.Errorf("Hysteria2 URI has invalid IPv6 port")
+		}
+		return authority[1:closeBracket], rest[1:], nil
+	}
+	if colon := strings.IndexByte(authority, ':'); colon >= 0 {
+		if colon == 0 || colon == len(authority)-1 {
+			return "", "", fmt.Errorf("Hysteria2 URI has invalid server port")
+		}
+		host, portText := authority[:colon], authority[colon+1:]
+		// A second colon is valid in the official port-union syntax
+		// (for example 20000:20002), but never in an unbracketed IPv6 host.
+		if strings.Contains(portText, ":") {
+			if _, _, err := parseHysteria2Ports(portText); err != nil {
+				return "", "", fmt.Errorf("Hysteria2 IPv6 server must be bracketed")
+			}
+		}
+		return host, portText, nil
+	}
+	return authority, "443", nil
+}
+
+func parseHysteria2Ports(value string) (uint16, badoption.Listable[string], error) {
+	if value == "" {
+		value = "443"
+	}
+	parts := strings.Split(value, ",")
+	normalized := make([]string, 0, len(parts))
+	var first uint16
+	for index, rawPart := range parts {
+		part := strings.TrimSpace(rawPart)
+		if part == "" {
+			return 0, nil, fmt.Errorf("Hysteria2 URI has an empty port")
+		}
+		separator := "-"
+		if strings.Contains(part, ":") {
+			if strings.Count(part, ":") != 1 {
+				return 0, nil, fmt.Errorf("Hysteria2 URI has invalid port range")
+			}
+			separator = ":"
+		}
+		bounds := strings.Split(part, separator)
+		if len(bounds) > 2 {
+			return 0, nil, fmt.Errorf("Hysteria2 URI has invalid port range")
+		}
+		start, startErr := strconv.Atoi(strings.TrimSpace(bounds[0]))
+		if startErr != nil || start < 1 || start > 65535 {
+			return 0, nil, fmt.Errorf("Hysteria2 URI has invalid port")
+		}
+		end := start
+		if len(bounds) == 2 {
+			var endErr error
+			end, endErr = strconv.Atoi(strings.TrimSpace(bounds[1]))
+			if endErr != nil || end < start || end > 65535 {
+				return 0, nil, fmt.Errorf("Hysteria2 URI has invalid port range")
+			}
+		}
+		if index == 0 {
+			first = uint16(start)
+		}
+		if start == end {
+			normalized = append(normalized, strconv.Itoa(start))
+		} else {
+			normalized = append(normalized, fmt.Sprintf("%d-%d", start, end))
+		}
+	}
+	if len(parts) == 1 && normalized[0] == strconv.Itoa(int(first)) {
+		return first, nil, nil
+	}
+	return first, badoption.Listable[string](normalized), nil
+}
+
+func parseHysteria2Query(rawQuery string) (map[string]string, error) {
+	values, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		return nil, fmt.Errorf("Hysteria2 URI has invalid query encoding")
+	}
+	result := make(map[string]string, len(values))
+	for key, list := range values {
+		if len(list) == 0 {
+			continue
+		}
+		result[canonicalHysteria2Key(key)] = list[0]
+	}
+	return result, nil
+}
+
+func canonicalHysteria2Key(value string) string {
+	key := strings.ToLower(strings.TrimSpace(value))
+	key = strings.NewReplacer("-", "", "_", "").Replace(key)
+	switch key {
+	case "servername", "peer":
+		return "sni"
+	case "allowinsecure", "skipcertverify":
+		return "insecure"
+	case "obfspassword":
+		return "obfspassword"
+	case "upmbps", "upbps":
+		return "up"
+	case "downmbps", "downbps":
+		return "down"
+	default:
+		return key
+	}
+}
+
+func hysteria2Bool(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "1", "true", "yes", "on":
+		return true
+	default:
+		return false
+	}
+}
+
+func parseHysteria2Mbps(value string) (int, error) {
+	fields := strings.Fields(strings.TrimSpace(value))
+	if len(fields) == 0 || len(fields) > 2 {
+		return 0, fmt.Errorf("invalid bandwidth")
+	}
+	amount, err := strconv.ParseInt(fields[0], 10, 64)
+	if err != nil || amount < 0 {
+		return 0, fmt.Errorf("invalid bandwidth")
+	}
+	unit := "mbps"
+	if len(fields) == 2 {
+		unit = strings.ToLower(fields[1])
+	}
+	factor := int64(1)
+	divisor := int64(1)
+	switch unit {
+	case "bps", "b/s":
+		divisor = 1_000_000
+	case "kbps", "kb/s":
+		divisor = 1_000
+	case "mbps", "mb/s":
+	case "gbps", "gb/s":
+		factor = 1_000
+	case "tbps", "tb/s":
+		factor = 1_000_000
+	default:
+		return 0, fmt.Errorf("invalid bandwidth unit")
+	}
+	maxInt := int64(^uint(0) >> 1)
+	if amount > maxInt/factor {
+		return 0, fmt.Errorf("bandwidth overflow")
+	}
+	return int(amount * factor / divisor), nil
+}
+
+func parseHysteria2PacketSizes(query map[string]string) (int, int, error) {
+	parse := func(key string) (int, error) {
+		value := strings.TrimSpace(query[key])
+		if value == "" {
+			return 0, nil
+		}
+		number, err := strconv.Atoi(value)
+		if err != nil || number < 0 {
+			return 0, fmt.Errorf("invalid Hysteria2 packet size")
+		}
+		return number, nil
+	}
+	minPacket, err := parse("minpacketsize")
+	if err != nil {
+		return 0, 0, err
+	}
+	maxPacket, err := parse("maxpacketsize")
+	if err != nil {
+		return 0, 0, err
+	}
+	if minPacket != 0 && maxPacket != 0 && minPacket > maxPacket {
+		return 0, 0, fmt.Errorf("invalid Hysteria2 packet size range")
+	}
+	if maxPacket > 2048 {
+		return 0, 0, fmt.Errorf("invalid Hysteria2 packet size")
+	}
+	return minPacket, maxPacket, nil
+}
+
+func normalizeHysteria2Pin(value string) (string, error) {
+	normalized := strings.NewReplacer(":", "", "-", "").Replace(strings.ToLower(strings.TrimSpace(value)))
+	decoded, err := hex.DecodeString(normalized)
+	if err != nil || len(decoded) != 32 {
+		return "", fmt.Errorf("Hysteria2 certificate pin must contain 32 SHA-256 bytes")
+	}
+	return normalized, nil
+}
+
+func decodeHysteria2ECH(value string) (string, error) {
+	if strings.Contains(value, "BEGIN ECH CONFIGS") {
+		return value, nil
+	}
+	compact := strings.Join(strings.Fields(value), "")
+	var decoded []byte
+	var err error
+	for _, encoding := range []*base64.Encoding{
+		base64.RawURLEncoding,
+		base64.URLEncoding,
+		base64.RawStdEncoding,
+		base64.StdEncoding,
+	} {
+		decoded, err = encoding.DecodeString(compact)
+		if err == nil {
+			break
+		}
+	}
+	if err != nil || len(decoded) == 0 {
+		return "", fmt.Errorf("invalid Hysteria2 ECH config")
+	}
+	return "-----BEGIN ECH CONFIGS-----\n" + base64.StdEncoding.EncodeToString(decoded) + "\n-----END ECH CONFIGS-----", nil
+}
