diff --git a/common/dialer/resolve.go b/common/dialer/resolve.go
index 21fe38d5..66282674 100644
--- a/common/dialer/resolve.go
+++ b/common/dialer/resolve.go
@@ -3,6 +3,7 @@ package dialer
 import (
 	"context"
 	"net"
+	"net/netip"
 	"sync"
 	"time"
 
@@ -112,23 +113,33 @@ func (d *resolveDialer) DialContext(ctx context.Context, network string, destina
 }
 
 func (d *resolveDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	conn, _, err := d.ListenPacketWithDestination(ctx, destination)
+	return conn, err
+}
+
+// ListenPacketWithDestination opens the same protected/bound socket as
+// ListenPacket, while exposing the address selected by sing-box DNS. Protocols
+// with native UDP port hopping need the selected IP without falling back to the
+// process resolver (which would bypass Android VPN socket protection).
+func (d *resolveDialer) ListenPacketWithDestination(ctx context.Context, destination M.Socksaddr) (net.PacketConn, netip.Addr, error) {
 	err := d.initialize()
 	if err != nil {
-		return nil, err
+		return nil, netip.Addr{}, err
 	}
 	if !destination.IsDomain() {
-		return d.dialer.ListenPacket(ctx, destination)
+		conn, err := d.dialer.ListenPacket(ctx, destination)
+		return conn, destination.Addr, err
 	}
 	ctx = log.ContextWithOverrideLevel(ctx, log.LevelDebug)
 	addresses, err := d.router.Lookup(ctx, destination.Fqdn, d.queryOptions)
 	if err != nil {
-		return nil, err
+		return nil, netip.Addr{}, err
 	}
 	conn, destinationAddress, err := N.ListenSerial(ctx, d.dialer, destination, addresses)
 	if err != nil {
-		return nil, err
+		return nil, netip.Addr{}, err
 	}
-	return bufio.NewNATPacketConn(bufio.NewPacketConn(conn), M.SocksaddrFrom(destinationAddress, destination.Port), destination), nil
+	return bufio.NewNATPacketConn(bufio.NewPacketConn(conn), M.SocksaddrFrom(destinationAddress, destination.Port), destination), destinationAddress, nil
 }
 
 func (d *resolveDialer) QueryOptions() adapter.DNSQueryOptions {
@@ -185,6 +196,10 @@ func (d *resolveParallelNetworkDialer) ListenSerialInterfacePacket(ctx context.C
 	return bufio.NewNATPacketConn(bufio.NewPacketConn(conn), M.SocksaddrFrom(destinationAddress, destination.Port), destination), nil
 }
 
+func (d *resolveParallelNetworkDialer) ListenPacketWithDestination(ctx context.Context, destination M.Socksaddr) (net.PacketConn, netip.Addr, error) {
+	return d.resolveDialer.ListenPacketWithDestination(ctx, destination)
+}
+
 func (d *resolveParallelNetworkDialer) QueryOptions() adapter.DNSQueryOptions {
 	return d.queryOptions
 }
