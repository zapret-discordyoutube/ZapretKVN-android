+func TestTLSBridgeSupportsCAClientCertificateAndECHPath(t *testing.T) {
+	certificate := syntheticCertificate(t)
+	certificatePEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate.Certificate[0]})
+	privateKey, err := x509.MarshalPKCS8PrivateKey(certificate.PrivateKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientKeyPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: privateKey})
+	tempDir := t.TempDir()
+	clientCertificatePath := tempDir + "/client.crt"
+	clientKeyPath := tempDir + "/client.key"
+	caPath := tempDir + "/ca.crt"
+	echPath := tempDir + "/ech.pem"
+	if err := os.WriteFile(clientCertificatePath, certificatePEM, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(clientKeyPath, clientKeyPEM, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(caPath, certificatePEM, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(echPath, []byte("-----BEGIN ECH CONFIGS-----\nAAECAw==\n-----END ECH CONFIGS-----\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(certificate.Certificate[0])
+	config, err := upstreamTLSConfig(context.Background(), option.Hysteria2OutboundOptions{
+		ServerOptions:     option.ServerOptions{Server: "synthetic.invalid", ServerPort: 443},
+		CertificateSHA256: hex.EncodeToString(digest[:]),
+		OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{
+			Enabled:               true,
+			Certificate:           badoption.Listable[string]{string(certificatePEM)},
+			ClientCertificatePath: clientCertificatePath,
+			ClientKeyPath:         clientKeyPath,
+			ECH:                   &option.OutboundECHOptions{Enabled: true, ConfigPath: echPath},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.RootCAs == nil || config.GetClientCertificate == nil || len(config.ECHConfigList) != 4 {
+		t.Fatalf("TLS bridge omitted CA/client certificate/ECH: %+v", config)
+	}
+	clientCertificate, err := config.GetClientCertificate(nil)
+	if err != nil || clientCertificate == nil || len(clientCertificate.Certificate) != 1 {
+		t.Fatalf("client certificate callback failed: %v", err)
+	}
+	if err := config.VerifyPeerCertificate([][]byte{certificate.Certificate[0]}, nil); err != nil {
+		t.Fatalf("combined certificate pin rejected: %v", err)
+	}
+
+	inlineConfig, err := upstreamTLSConfig(context.Background(), option.Hysteria2OutboundOptions{
+		ServerOptions:     option.ServerOptions{Server: "synthetic.invalid", ServerPort: 443},
+		CertificateSHA256: hex.EncodeToString(digest[:]),
+		OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{
+			Enabled:           true,
+			CertificatePath:   caPath,
+			ClientCertificate: badoption.Listable[string]{string(certificatePEM)},
+			ClientKey:         badoption.Listable[string]{string(clientKeyPEM)},
+			ECH: &option.OutboundECHOptions{
+				Enabled: true,
+				Config: badoption.Listable[string]{
+					"-----BEGIN ECH CONFIGS-----\nAAECAw==\n-----END ECH CONFIGS-----\n",
+				},
+			},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inlineConfig.RootCAs == nil || inlineConfig.GetClientCertificate == nil || len(inlineConfig.ECHConfigList) != 4 {
+		t.Fatalf("inline mTLS/path CA/inline ECH bridge omitted material: %+v", inlineConfig)
+	}
+}
