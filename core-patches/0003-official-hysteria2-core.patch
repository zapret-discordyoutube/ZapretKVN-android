+type hyPacketConn struct {
+	conn hyclient.HyUDPConn
+}
+
+func (c *hyPacketConn) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	payload, address, err := c.conn.Receive()
+	if err != nil {
+		return 0, nil, err
+	}
+	n := copy(buffer, payload)
+	return n, M.ParseSocksaddr(address), nil
+}
+
+func (c *hyPacketConn) WriteTo(buffer []byte, address net.Addr) (int, error) {
+	err := c.conn.Send(buffer, M.SocksaddrFromNet(address).String())
+	if err != nil {
+		return 0, err
+	}
+	return len(buffer), nil
 }
