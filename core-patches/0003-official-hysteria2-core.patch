+func TestInterfaceUpdateReplacesAndClosesHysteria2Client(t *testing.T) {
+	oldClient := &stubClient{}
+	outbound := &Outbound{client: oldClient}
+	outbound.InterfaceUpdated(context.Background())
+	if !oldClient.closed.Load() {
+		t.Fatal("network recreation did not close the previous client")
+	}
+	if outbound.currentClient() == oldClient {
+		t.Fatal("network recreation did not install a fresh reconnectable client")
+	}
+	if err := outbound.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
