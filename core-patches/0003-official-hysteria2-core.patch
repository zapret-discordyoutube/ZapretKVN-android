+func normalizePortUnion(ports badoption.Listable[string]) string {
+	normalized := make([]string, 0, len(ports))
+	for _, value := range ports {
+		normalized = append(normalized, strings.ReplaceAll(strings.TrimSpace(value), ":", "-"))
+	}
+	return strings.Join(normalized, ",")
+}
+
+func (f *protectedConnFactory) New(net.Addr) (net.PacketConn, error) {
+	listen := func() (net.PacketConn, error) {
+		f.access.Lock()
+		if f.firstConn != nil {
+			conn := f.firstConn
+			f.firstConn = nil
+			f.access.Unlock()
+			return conn, nil
+		}
+		f.access.Unlock()
+		return f.dialer.ListenPacket(f.ctx, f.destination)
+	}
+	var (
+		conn net.PacketConn
+		err  error
+	)
+	if f.hopAddr != nil {
+		interval := udphop.HopIntervalConfig{Min: f.hopInterval, Max: f.hopInterval}
+		conn, err = udphop.NewUDPHopPacketConn(f.hopAddr, interval, listen)
+	} else {
+		conn, err = listen()
+	}
+	if err != nil {
+		return nil, err
+	}
+	typeName := ""
+	if f.obfs != nil {
+		typeName = strings.ToLower(strings.TrimSpace(f.obfs.Type))
+	}
+	if typeName == "" || typeName == "none" || typeName == "plain" {
+		return conn, nil
+	}
+	switch typeName {
+	case "salamander":
+		return hyobfs.WrapPacketConnSalamander(conn, []byte(f.obfs.Password))
+	case "gecko":
+		return hyobfs.WrapPacketConnGecko(conn, hyobfs.GeckoOptions{
+			Password:      []byte(f.obfs.Password),
+			MinPacketSize: f.obfs.MinPacketSize,
+			MaxPacketSize: f.obfs.MaxPacketSize,
+		})
+	default:
+		_ = conn.Close()
+		return nil, E.New("unknown obfs type: ", f.obfs.Type)
+	}
+}
+
+func (f *protectedConnFactory) Close() error {
+	f.access.Lock()
+	defer f.access.Unlock()
+	if f.firstConn == nil {
+		return nil
+	}
+	err := f.firstConn.Close()
+	f.firstConn = nil
+	return err
+}
