+func TestOfficialObfsValidation(t *testing.T) {
+	for _, obfsType := range []string{"salamander", "gecko"} {
+		if err := validateObfs(&option.Hysteria2Obfs{Type: obfsType, Password: "synthetic"}); err != nil {
+			t.Fatalf("%s rejected: %v", obfsType, err)
+		}
+	}
+	if err := validateObfs(&option.Hysteria2Obfs{Type: "gecko"}); err == nil {
+		t.Fatal("passwordless gecko accepted")
+	}
+	if got := normalizePortUnion(badoption.Listable[string]{"443", "20000:20002"}); got != "443,20000-20002" {
+		t.Fatalf("unexpected port union %q", got)
+	}
+}
