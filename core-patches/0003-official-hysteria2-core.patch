+
+func newProtectedConnFactory(ctx context.Context, outboundDialer N.Dialer, options option.Hysteria2OutboundOptions) (*protectedConnFactory, net.Addr, error) {
+	destination := options.ServerOptions.Build()
+	var (
+		conn net.PacketConn
+		ip   netip.Addr
+		err  error
+	)
+	if destination.IsDomain() {
+		resolvedDialer, ok := outboundDialer.(dialer.PacketDialerWithDestination)
+		if !ok {
+			return nil, nil, E.New("protected Hysteria2 dialer cannot expose resolved server address")
+		}
+		conn, ip, err = resolvedDialer.ListenPacketWithDestination(ctx, destination)
+	} else {
+		conn, err = outboundDialer.ListenPacket(ctx, destination)
+		ip = destination.Addr
+	}
+	if err != nil {
+		return nil, nil, E.Cause(err, "open protected Hysteria2 packet socket")
+	}
+	factory := &protectedConnFactory{
+		ctx:         ctx,
+		dialer:      outboundDialer,
+		destination: M.SocksaddrFrom(ip, destination.Port),
+		firstConn:   conn,
+		hopInterval: time.Duration(options.HopInterval),
+		obfs:        options.Obfs,
+	}
+	if len(options.ServerPorts) == 0 {
+		return factory, factory.destination.UDPAddr(), nil
+	}
+	portUnion := normalizePortUnion(options.ServerPorts)
+	hopAddr, err := udphop.ResolveUDPHopAddr(net.JoinHostPort(ip.String(), portUnion))
+	if err != nil {
+		_ = conn.Close()
+		return nil, nil, E.Cause(err, "parse Hysteria2 server_ports")
+	}
+	factory.hopAddr = hopAddr
+	return factory, hopAddr, nil
