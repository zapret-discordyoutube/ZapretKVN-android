+func upstreamTLSConfig(ctx context.Context, options option.Hysteria2OutboundOptions) (hyclient.TLSConfig, error) {
+	tlsOptions := options.TLS
+	if tlsOptions == nil {
+		return hyclient.TLSConfig{}, E.New("missing Hysteria2 TLS options")
+	}
+	pin, err := certificatePin(options.CertificateSHA256)
+	if err != nil {
+		return hyclient.TLSConfig{}, err
+	}
+	serverName := options.Server
+	if tlsOptions.ServerName != "" {
+		serverName = tlsOptions.ServerName
+	}
+	if tlsOptions.DisableSNI {
+		serverName = ""
+	}
+	config := hyclient.TLSConfig{
+		ServerName:         serverName,
+		InsecureSkipVerify: tlsOptions.Insecure || tlsOptions.DisableSNI,
+		RootCAs:            adapter.RootPoolFromContext(ctx),
+	}
+	caPEM, err := hysteria2TLSMaterial(tlsOptions.Certificate, tlsOptions.CertificatePath, "certificate")
+	if err != nil {
+		return hyclient.TLSConfig{}, err
+	}
+	if len(caPEM) > 0 {
+		rootPool := x509.NewCertPool()
+		if !rootPool.AppendCertsFromPEM(caPEM) {
+			return hyclient.TLSConfig{}, E.New("invalid Hysteria2 custom CA certificate")
+		}
+		config.RootCAs = rootPool
+	}
+	clientCertificate, err := hysteria2TLSMaterial(tlsOptions.ClientCertificate, tlsOptions.ClientCertificatePath, "client certificate")
+	if err != nil {
+		return hyclient.TLSConfig{}, err
+	}
+	clientKey, err := hysteria2TLSMaterial(tlsOptions.ClientKey, tlsOptions.ClientKeyPath, "client key")
+	if err != nil {
+		return hyclient.TLSConfig{}, err
+	}
+	if len(clientCertificate) != 0 || len(clientKey) != 0 {
+		if len(clientCertificate) == 0 || len(clientKey) == 0 {
+			return hyclient.TLSConfig{}, E.New("Hysteria2 client certificate and key must be provided together")
+		}
+		keyPair, pairErr := tls.X509KeyPair(clientCertificate, clientKey)
+		if pairErr != nil {
+			return hyclient.TLSConfig{}, E.New("invalid Hysteria2 client certificate/key")
+		}
+		config.GetClientCertificate = func(*tls.CertificateRequestInfo) (*tls.Certificate, error) {
+			return &keyPair, nil
+		}
+	}
+	if len(pin) > 0 {
+		config.VerifyPeerCertificate = func(rawCerts [][]byte, _ [][]*x509.Certificate) error {
+			if len(rawCerts) == 0 {
+				return E.New("no server certificate for certificate_sha256")
+			}
+			digest := sha256.Sum256(rawCerts[0])
+			if subtle.ConstantTimeCompare(digest[:], pin) != 1 {
+				return E.New("server certificate SHA-256 mismatch")
+			}
+			return nil
+		}
+	}
+	if tlsOptions.ECH != nil && tlsOptions.ECH.Enabled {
+		echBytes, err := hysteria2TLSMaterial(tlsOptions.ECH.Config, tlsOptions.ECH.ConfigPath, "ECH config")
+		if err != nil {
+			return hyclient.TLSConfig{}, err
+		}
+		if len(echBytes) == 0 {
+			return hyclient.TLSConfig{}, E.New("Hysteria2 ECH requires tls.ech.config or tls.ech.config_path")
+		}
+		block, rest := pem.Decode(bytes.TrimSpace(echBytes))
+		if block == nil || block.Type != "ECH CONFIGS" || len(bytes.TrimSpace(rest)) != 0 {
+			return hyclient.TLSConfig{}, E.New("invalid Hysteria2 ECH configs PEM")
+		}
+		config.ECHConfigList = block.Bytes
+	}
+	return config, nil
+}
+
+func hysteria2TLSMaterial(inline badoption.Listable[string], path string, name string) ([]byte, error) {
+	if len(inline) > 0 {
+		return []byte(strings.Join(inline, "\n")), nil
+	}
+	if path == "" {
+		return nil, nil
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, E.New("unable to read Hysteria2 ", name)
+	}
+	return content, nil
+}
+
+func certificatePin(value string) ([]byte, error) {
+	normalized := strings.NewReplacer(":", "", "-", "").Replace(strings.ToLower(strings.TrimSpace(value)))
+	if normalized == "" {
+		return nil, nil
+	}
+	decoded, err := hex.DecodeString(normalized)
+	if err != nil || len(decoded) != sha256.Size {
+		return nil, E.New("certificate_sha256 must contain exactly 32 SHA-256 bytes")
+	}
+	return decoded, nil
+}
