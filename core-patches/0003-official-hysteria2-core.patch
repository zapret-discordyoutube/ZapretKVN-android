+func TestProtectedFactoryPortHoppingRebindsThroughSingBoxDialer(t *testing.T) {
+	dialer := &stubDialer{packetConn: &stubPacketConn{}, address: netip.MustParseAddr("192.0.2.10")}
+	factory, serverAddr, err := newProtectedConnFactory(context.Background(), dialer, option.Hysteria2OutboundOptions{
+		ServerOptions: option.ServerOptions{Server: "synthetic.example", ServerPort: 443},
+		ServerPorts:   badoption.Listable[string]{"443", "20000:20002"},
+		HopInterval:   badoption.Duration(5 * time.Second),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if factory.hopAddr == nil || !reflect.DeepEqual(factory.hopAddr.Ports, []uint16{443, 20000, 20001, 20002}) {
+		t.Fatalf("unexpected hop address: %+v", factory.hopAddr)
+	}
+	conn, err := factory.New(serverAddr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	deadline := time.Now().Add(7 * time.Second)
+	for dialer.listenCalls.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(25 * time.Millisecond)
+	}
+	if dialer.listenCalls.Load() == 0 {
+		t.Fatal("port hopping did not obtain a fresh protected packet socket")
+	}
+}
