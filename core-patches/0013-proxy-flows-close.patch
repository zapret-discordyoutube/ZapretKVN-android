+
+// CloseFlows закрывает перечисленные потоки через прокси: приложение получает сброс и сразу открывает новое
+// соединение, вместо того чтобы ждать свой долгий таймаут на зависшем. Возвращает число закрытых. Чужие
+// идентификаторы, прямые и служебные потоки не трогаются: закрыть можно только поток через прокси.
+func (m *Manager) CloseFlows(ids []string) int {
+	closed := 0
+	for _, raw := range ids {
+		id, err := uuid.FromString(strings.TrimSpace(raw))
+		if err != nil {
+			continue
+		}
+		tracker := m.Connection(id)
+		if tracker == nil || !IsProxyOutboundType(tracker.Metadata().OutboundType) {
+			continue
+		}
+		if err := tracker.Close(); err == nil {
+			closed++
+		}
+	}
+	return closed
+}
