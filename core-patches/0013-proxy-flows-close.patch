+// CloseFlowsText закрывает потоки через прокси по идентификаторам (по одному на строку) и возвращает число закрытых.
+func (s *StartedService) CloseFlowsText(ids string) (int, error) {
+	s.serviceAccess.RLock()
+	nowService := s.instance
+	s.serviceAccess.RUnlock()
+	if nowService == nil || nowService.trafficManager == nil {
+		return 0, E.New("service is not started")
+	}
+	return nowService.trafficManager.CloseFlows(strings.Split(ids, "\n")), nil
+}
