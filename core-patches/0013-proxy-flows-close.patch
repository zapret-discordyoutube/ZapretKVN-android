+package trafficcontrol
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/bufio"
+)
+
+func trackerOnPipe(t *testing.T, m *Manager, outboundType string) (*connTracker, net.Conn) {
+	t.Helper()
+	client, remote := net.Pipe()
+	tracker := trackerWith(m, outboundType, 10, 20)
+	tracker.ExtendedConn = bufio.NewExtendedConn(client)
+	return tracker, remote
+}
+
+func TestCloseFlowsClosesProxyFlowsOnly(t *testing.T) {
+	m := NewManager(nil)
+	proxy, proxyRemote := trackerOnPipe(t, m, "hysteria2")
+	direct, directRemote := trackerOnPipe(t, m, "direct")
+	defer proxyRemote.Close()
+	defer directRemote.Close()
+
+	closed := m.CloseFlows([]string{proxy.metadata.ID.String(), direct.metadata.ID.String(), "not-a-uuid", "", " "})
+	if closed != 1 {
+		t.Fatalf("closed = %d, want 1 (only the proxy flow)", closed)
+	}
+	if m.Connection(proxy.metadata.ID) != nil {
+		t.Fatal("the closed proxy flow must leave the manager")
+	}
+	if m.Connection(direct.metadata.ID) == nil {
+		t.Fatal("a direct flow must stay")
+	}
+	_ = proxyRemote.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := proxyRemote.Read(make([]byte, 1)); err == nil {
+		t.Fatal("the other end of the closed flow must see the connection closed")
+	}
+}
+
+func TestCloseFlowsIgnoresUnknownIdsAndRepeats(t *testing.T) {
+	m := NewManager(nil)
+	proxy, remote := trackerOnPipe(t, m, "vless")
+	defer remote.Close()
+	id := proxy.metadata.ID.String()
+	if got := m.CloseFlows([]string{"00000000-0000-0000-0000-000000000000"}); got != 0 {
+		t.Fatalf("unknown id closed %d flows", got)
+	}
+	if got := m.CloseFlows([]string{id}); got != 1 {
+		t.Fatalf("first close = %d, want 1", got)
+	}
+	if got := m.CloseFlows([]string{id}); got != 0 {
+		t.Fatalf("repeated close = %d, want 0", got)
+	}
+}
