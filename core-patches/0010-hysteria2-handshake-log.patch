+package hysteria2
+
+import (
+	"testing"
+
+	hyclient "github.com/apernet/hysteria/core/v2/client"
+)
+
+func TestDescribeHandshake(t *testing.T) {
+	cases := []struct {
+		name string
+		info hyclient.HandshakeInfo
+		up   int
+		down int
+		want string
+	}{
+		{"bbr", hyclient.HandshakeInfo{UDPEnabled: true, Tx: 0}, 0, 0,
+			"udp=true, congestion=BBR, configured up/down=0/0 Mbps, ech=false"},
+		{"brutal", hyclient.HandshakeInfo{UDPEnabled: true, Tx: 12_500_000}, 100, 200,
+			"udp=true, congestion=Brutal 100 Mbit/s, configured up/down=100/200 Mbps, ech=false"},
+		{"udp off with ech", hyclient.HandshakeInfo{UDPEnabled: false, ECHAccepted: true}, 50, 50,
+			"udp=false, congestion=BBR, configured up/down=50/50 Mbps, ech=true"},
+	}
+	for _, c := range cases {
+		info := c.info
+		if got := describeHandshake(&info, c.up, c.down); got != c.want {
+			t.Errorf("%s: got %q, want %q", c.name, got, c.want)
+		}
+	}
+}
