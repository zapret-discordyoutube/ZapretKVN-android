+// describeHandshake: условия, о которых клиент и сервер договорились при рукопожатии. По ним в журнале
+// видно, работает ли UDP, какое управление перегрузкой (BBR или Brutal на заданной скорости) и принят ли ECH.
+func describeHandshake(info *hyclient.HandshakeInfo, upMbps, downMbps int) string {
+	congestion := "BBR"
+	if info.Tx > 0 {
+		congestion = "Brutal " + strconv.FormatUint(info.Tx*8/1_000_000, 10) + " Mbit/s"
+	}
+	return "udp=" + strconv.FormatBool(info.UDPEnabled) +
+		", congestion=" + congestion +
+		", configured up/down=" + strconv.Itoa(upMbps) + "/" + strconv.Itoa(downMbps) + " Mbps" +
+		", ech=" + strconv.FormatBool(info.ECHAccepted)
+}
