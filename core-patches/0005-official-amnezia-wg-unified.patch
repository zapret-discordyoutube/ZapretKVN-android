+func TestAndroidClientBindHonorsProtectedListenPort(t *testing.T) {
+	reserve, err := net.ListenPacket("udp", ":0")
+	require.NoError(t, err)
+	port := uint16(reserve.LocalAddr().(*net.UDPAddr).Port)
+	require.NoError(t, reserve.Close())
+	var calls atomic.Int32
+	bind := NewAndroidClientBind(context.Background(), logger.NOP(), protectedTestDialer{calls: &calls}, nil)
+	defer bind.Close()
+	_, actual, err := bind.Open(port)
+	require.NoError(t, err)
+	require.Equal(t, port, actual)
+	require.Equal(t, 1, int(calls.Load()))
+	require.Equal(t, int(port), bind.conn.LocalAddr().(*net.UDPAddr).Port)
+	blocked, err := net.ListenPacket("udp", fmt.Sprintf(":%d", port))
+	if blocked != nil {
+		blocked.Close()
+	}
+	require.Error(t, err, "requested port must actually be owned")
+	require.NoError(t, bind.Close())
+	_, actual, err = bind.Open(port)
+	require.NoError(t, err)
+	require.Equal(t, port, actual)
+	require.Equal(t, 2, int(calls.Load()), "reopen must protect the new socket again")
+}
+
