+package option
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestWireGuardRangesDoNotNarrowOrWrap(t *testing.T) {
+	for _, raw := range []string{`"4294967296"`, `"-1"`, `"0-4294967296"`, `"20-10"`, `{"from":0,"to":4294967296}`} {
+		var options WireGuardAmnezia
+		if err := json.Unmarshal([]byte(`{"h1":`+raw+`}`), &options); err == nil {
+			t.Errorf("accepted %s", raw)
+		}
+		var peer WireGuardPeer
+		if err := json.Unmarshal([]byte(`{"persistent_keepalive_interval":`+raw+`}`), &peer); err == nil {
+			t.Errorf("accepted keepalive %s", raw)
+		}
+	}
+	for _, raw := range []string{`0`, `4294967295`, `"20-30"`, `{"from":10,"to":20}`} {
+		var options WireGuardAmnezia
+		if err := json.Unmarshal([]byte(`{"h1":`+raw+`,"random_trailers":true,"disable_cookies":false}`), &options); err != nil {
+			t.Errorf("rejected %s: %v", raw, err)
+		}
+	}
+}
