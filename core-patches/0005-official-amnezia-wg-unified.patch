diff --git a/option/wireguard_validation.go b/option/wireguard_validation.go
new file mode 100644
index 00000000..f54119d4
--- /dev/null
+++ b/option/wireguard_validation.go
@@ -0,0 +1,89 @@
+package option
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Validate the original representation before badoption.Range can narrow an
+// int64 string into uint32. A malformed native JSON must not silently change
+// the user's cryptographic headers or timing parameters.
+func validateWireGuardRange(raw json.RawMessage) error {
+	if bytes.Equal(raw, []byte("null")) {
+		return nil
+	}
+	var text string
+	if json.Unmarshal(raw, &text) == nil {
+		parts := strings.Split(text, "-")
+		if len(parts) < 1 || len(parts) > 2 {
+			return fmt.Errorf("invalid uint32 range")
+		}
+		var first uint64
+		for i, part := range parts {
+			if part == "" || strings.Trim(part, "0123456789") != "" {
+				return fmt.Errorf("invalid uint32 range")
+			}
+			n, err := strconv.ParseUint(part, 10, 32)
+			if err != nil {
+				return fmt.Errorf("invalid uint32 range")
+			}
+			if i == 0 {
+				first = n
+			} else if n < first {
+				return fmt.Errorf("reversed uint32 range")
+			}
+		}
+		return nil
+	}
+	var number uint32
+	if json.Unmarshal(raw, &number) == nil {
+		return nil
+	}
+	var bounds struct {
+		From *uint32 `json:"from"`
+		To   *uint32 `json:"to"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&bounds); err != nil || bounds.From == nil || bounds.To == nil || *bounds.From > *bounds.To {
+		return fmt.Errorf("invalid uint32 range")
+	}
+	return nil
+}
+
+func (a *WireGuardAmnezia) UnmarshalJSON(data []byte) error {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return err
+	}
+	for _, field := range []string{"h1", "h2", "h3", "h4", "content_padding_addition", "rekey_after_time", "rekey_timeout", "reject_after_time", "keepalive_timeout", "max_handshake_attempts"} {
+		if raw, found := fields[field]; found {
+			if err := validateWireGuardRange(raw); err != nil {
+				return fmt.Errorf("amnezia.%s: %w", field, err)
+			}
+		}
+	}
+	type plain WireGuardAmnezia
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	return decoder.Decode((*plain)(a))
+}
+
+func (p *WireGuardPeer) UnmarshalJSON(data []byte) error {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return err
+	}
+	if raw, found := fields["persistent_keepalive_interval"]; found {
+		if err := validateWireGuardRange(raw); err != nil {
+			return fmt.Errorf("persistent_keepalive_interval: %w", err)
+		}
+	}
+	type plain WireGuardPeer
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	return decoder.Decode((*plain)(p))
+}
diff --git a/option/wireguard_validation_test.go b/option/wireguard_validation_test.go
new file mode 100644
index 00000000..8a9a5f5b
--- /dev/null
+++ b/option/wireguard_validation_test.go
@@ -0,0 +1,25 @@
+package option
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestWireGuardRangesDoNotNarrowOrWrap(t *testing.T) {
+	for _, raw := range []string{`"4294967296"`, `"-1"`, `"0-4294967296"`, `"20-10"`, `{"from":0,"to":4294967296}`} {
+		var options WireGuardAmnezia
+		if err := json.Unmarshal([]byte(`{"h1":`+raw+`}`), &options); err == nil {
+			t.Errorf("accepted %s", raw)
+		}
+		var peer WireGuardPeer
+		if err := json.Unmarshal([]byte(`{"persistent_keepalive_interval":`+raw+`}`), &peer); err == nil {
+			t.Errorf("accepted keepalive %s", raw)
+		}
+	}
+	for _, raw := range []string{`0`, `4294967295`, `"20-30"`, `{"from":10,"to":20}`} {
+		var options WireGuardAmnezia
+		if err := json.Unmarshal([]byte(`{"h1":`+raw+`,"random_trailers":true,"disable_cookies":false}`), &options); err != nil {
+			t.Errorf("rejected %s: %v", raw, err)
+		}
+	}
+}
