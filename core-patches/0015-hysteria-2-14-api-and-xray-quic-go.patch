diff --git a/protocol/xraycore/prepare.sh b/protocol/xraycore/prepare.sh
index 68193a34..15ae4e33 100644
--- a/protocol/xraycore/prepare.sh
+++ b/protocol/xraycore/prepare.sh
@@ -1,8 +1,12 @@
 #!/usr/bin/env bash
 set -euo pipefail
 
-# The only local Xray change is logger interface integration with the pinned
-# sing fork. Protocol code is copied unchanged from the verified upstream module.
+# Protocol code is copied from the verified upstream module. The only local changes are listed here, each with its reason
+# and the condition that removes it:
+#   xray-quic-go-http-stream.patch (core patch 0015, owner decision 2026-11-15): official Hysteria 2.14.0 needs
+#   apernet/quic-go v0.65.1, one call of Xray's MASQUE transport (`HTTPStream()`) returns an extra error there and does not
+#   compile against the version Xray v26.11.9 was written for (v0.61.1). Remove the patch and this step when the pinned
+#   Xray builds against the quic-go that Hysteria requires.
 source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
 module="$1"
 expected_commit="$2"
@@ -19,3 +23,5 @@ trap 'rm -rf -- "$temporary"' EXIT
 cp -a "$module_dir/." "$temporary/"
 chmod -R u+w "$temporary"
 mv "$temporary" "$destination"
+# `git apply` also works outside a repository; it fails closed when the context no longer matches the Xray source.
+(cd "$destination" && git apply --whitespace=nowarn "$source_root/protocol/xraycore/xray-quic-go-http-stream.patch")
