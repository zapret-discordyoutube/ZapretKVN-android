@@ -0,0 +1,77 @@
+package trafficcontrol
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+func closedFlow(outboundType string, closedAt time.Time, up, down int64) TrackerMetadata {
+	id, _ := uuid.NewV4()
+	return TrackerMetadata{
+		ID: id, OutboundType: outboundType, CreatedAt: closedAt.Add(-3 * time.Second), ClosedAt: closedAt,
+		Upload: atomicOf(up), Download: atomicOf(down),
+	}
+}
+
+func TestProxyFlowsListsOnlyProxyFlowsHeaviestFirst(t *testing.T) {
+	m := NewManager(nil)
+	trackerWith(m, "hysteria2", 10, 100)
+	trackerWith(m, "direct", 1, 99999)
+	trackerWith(m, "vless", 20, 5000)
+	trackerWith(m, "dns", 1, 1)
+	active, closed := m.ProxyFlows(0, 10)
+	if len(closed) != 0 {
+		t.Fatalf("closed = %d, want 0", len(closed))
+	}
+	if len(active) != 2 || active[0].Download != 5000 || active[1].Download != 100 {
+		t.Fatalf("active = %+v, want the two proxy flows by download desc", active)
+	}
+}
+
+func TestProxyFlowsLimitAndClosedCursor(t *testing.T) {
+	m := NewManager(nil)
+	for i := 0; i < 5; i++ {
+		trackerWith(m, "hysteria2", 1, int64(i))
+	}
+	active, _ := m.ProxyFlows(0, 3)
+	if len(active) != 3 {
+		t.Fatalf("limit not applied: %d", len(active))
+	}
+	base := time.Now().Add(-time.Minute)
+	m.closedConnections.PushBack(closedFlow("hysteria2", base.Add(1*time.Second), 1, 10))
+	m.closedConnections.PushBack(closedFlow("direct", base.Add(2*time.Second), 1, 20))
+	m.closedConnections.PushBack(closedFlow("vless", base.Add(3*time.Second), 2, 30))
+	_, closed := m.ProxyFlows(base.Add(1*time.Second).UnixMilli(), 10)
+	if len(closed) != 1 || closed[0].Download != 30 {
+		t.Fatalf("closed after cursor = %+v, want only the newest proxy flow", closed)
+	}
+	_, all := m.ProxyFlows(0, 10)
+	if len(all) != 2 {
+		t.Fatalf("closed proxy flows = %d, want 2 (direct is excluded)", len(all))
+	}
+	if all[0].ClosedAt <= all[1].ClosedAt {
+		t.Fatalf("closed flows must be newest first: %+v", all)
+	}
+}
+
+func TestProxyFlowsJSONIsValidAndNeverNull(t *testing.T) {
+	m := NewManager(nil)
+	data, err := m.ProxyFlowsJSON(0, 5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded struct {
+		At     int64            `json:"at"`
+		Active []map[string]any `json:"active"`
+		Closed []map[string]any `json:"closed"`
+	}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatalf("invalid json %q: %v", data, err)
+	}
+	if decoded.At == 0 || decoded.Active == nil || decoded.Closed == nil {
+		t.Fatalf("decoded = %+v from %s, want at set and empty arrays instead of null", decoded, data)
+	}
+}
