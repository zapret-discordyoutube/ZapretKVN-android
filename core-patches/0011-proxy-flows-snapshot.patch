index 00000000..6ad06254
--- /dev/null
+++ b/common/trafficcontrol/proxy_flows.go
@@ -0,0 +1,102 @@
+package trafficcontrol
+
+import (
+	"encoding/json"
+	"sort"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+// FlowSnapshot — один поток через прокси для подробного журнала приложения.
+type FlowSnapshot struct {
+	ID          string `json:"id"`
+	Network     string `json:"net,omitempty"`
+	Domain      string `json:"domain,omitempty"`
+	Destination string `json:"dest,omitempty"`
+	Package     string `json:"pkg,omitempty"`
+	Outbound    string `json:"out,omitempty"`
+	CreatedAt   int64  `json:"created"`
+	ClosedAt    int64  `json:"closed,omitempty"`
+	Upload      int64  `json:"up"`
+	Download    int64  `json:"down"`
+}
+
+func flowSnapshotOf(metadata *TrackerMetadata) FlowSnapshot {
+	snapshot := FlowSnapshot{
+		ID:          metadata.ID.String(),
+		Network:     metadata.Metadata.Network,
+		Domain:      metadata.Metadata.Domain,
+		Destination: metadata.Metadata.Destination.String(),
+		Outbound:    metadata.Outbound,
+		Upload:      metadata.Upload.Load(),
+		Download:    metadata.Download.Load(),
+	}
+	if snapshot.Domain == "" {
+		snapshot.Domain = metadata.Metadata.Destination.Fqdn
+	}
+	if !metadata.CreatedAt.IsZero() {
+		snapshot.CreatedAt = metadata.CreatedAt.UnixMilli()
+	}
+	if !metadata.ClosedAt.IsZero() {
+		snapshot.ClosedAt = metadata.ClosedAt.UnixMilli()
+	}
+	if owner := metadata.Metadata.ProcessInfo; owner != nil && len(owner.AndroidPackageNames) > 0 {
+		snapshot.Package = owner.AndroidPackageNames[0]
+	}
+	return snapshot
+}
+
+// ProxyFlows — потоки только через прокси: активные (тяжёлые по входящему первыми, не больше limit)
+// и закрытые после closedAfterMillis (из хранимых последних, самые новые не больше limit).
+// Вызывается приложением прямо в момент своего отсчёта: подписки на соединения нет
+// (инвариант I6-05, как у ProxyTotal).
+func (m *Manager) ProxyFlows(closedAfterMillis int64, limit int) (active []FlowSnapshot, closed []FlowSnapshot) {
+	if limit <= 0 {
+		limit = 1
+	}
+	m.connections.Range(func(_ uuid.UUID, tracker Tracker) bool {
+		metadata := tracker.Metadata()
+		if IsProxyOutboundType(metadata.OutboundType) {
+			active = append(active, flowSnapshotOf(metadata))
+		}
+		return true
+	})
+	sort.Slice(active, func(i, j int) bool { return active[i].Download > active[j].Download })
+	if len(active) > limit {
+		active = active[:limit]
+	}
+	m.closedConnectionsAccess.Lock()
+	values := m.closedConnections.Array()
+	m.closedConnectionsAccess.Unlock()
+	for i := len(values) - 1; i >= 0; i-- {
+		metadata := values[i]
+		if metadata.ClosedAt.UnixMilli() <= closedAfterMillis {
+			break
+		}
+		if IsProxyOutboundType(metadata.OutboundType) {
+			closed = append(closed, flowSnapshotOf(&metadata))
+			if len(closed) >= limit {
+				break
+			}
+		}
+	}
+	return active, closed
+}
+
+// ProxyFlowsJSON — тот же снимок одной строкой JSON: `{"at":мс,"active":[…],"closed":[…]}`.
+func (m *Manager) ProxyFlowsJSON(closedAfterMillis int64, limit int) ([]byte, error) {
+	active, closed := m.ProxyFlows(closedAfterMillis, limit)
+	return json.Marshal(struct {
+		At     int64          `json:"at"`
+		Active []FlowSnapshot `json:"active"`
+		Closed []FlowSnapshot `json:"closed"`
+	}{time.Now().UnixMilli(), nonNil(active), nonNil(closed)})
+}
+
+func nonNil(flows []FlowSnapshot) []FlowSnapshot {
+	if flows == nil {
+		return []FlowSnapshot{}
+	}
+	return flows
+}
diff --git a/common/trafficcontrol/proxy_flows_test.go b/common/trafficcontrol/proxy_flows_test.go
