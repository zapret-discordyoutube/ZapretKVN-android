+// WebSocket and HTTPUpgrade are HTTP/1.1-only: a server that selects h2 drops the handshake.
+func TestHTTP1OnlyTransportsDropH2FromALPN(t *testing.T) {
+	for _, network := range []string{"ws", "httpupgrade"} {
+		outbound := trojanDocument(t, "trojan://pw@vpn.example.com:443?type="+network+"&path=%2Fp&alpn=h2%2Chttp%2F1.1")
+		alpn := outbound["streamSettings"].(map[string]any)["tlsSettings"].(map[string]any)["alpn"]
+		if !reflect.DeepEqual(alpn, []any{"http/1.1"}) {
+			t.Fatalf("%s alpn = %v", network, alpn)
+		}
+		only := trojanDocument(t, "trojan://pw@vpn.example.com:443?type="+network+"&path=%2Fp&alpn=h2")
+		if _, ok := only["streamSettings"].(map[string]any)["tlsSettings"].(map[string]any)["alpn"]; ok {
+			t.Fatalf("%s with only h2 must fall back to Xray's own default", network)
+		}
+	}
+	grpc := trojanDocument(t, "trojan://pw@vpn.example.com:443?type=grpc&serviceName=g&alpn=h2")
+	if !reflect.DeepEqual(grpc["streamSettings"].(map[string]any)["tlsSettings"].(map[string]any)["alpn"], []any{"h2"}) {
+		t.Fatal("gRPC keeps h2")
+	}
+}
