+func TestMaskingAndDesyncReachTrojanAndVMess(t *testing.T) {
+	masking := map[string]any{"mux": map[string]any{"enabled": true, "concurrency": 4}, "desync": map[string]any{"mode": "off"}}
+	data, err := buildTrojanConfig(option.TrojanOutboundOptions{URI: "trojan://pw@vpn.example.com:443", XrayMasking: map[string]any{"mux": masking["mux"]}}, "d")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if outbound := xrayAccepts(t, data); outbound["mux"] == nil {
+		t.Fatal("the masking block must be merged into the Trojan outbound")
+	}
+	if _, err = desyncPlanFrom(nil); err != nil {
+		t.Fatalf("absent desync is off: %v", err)
+	}
+}
