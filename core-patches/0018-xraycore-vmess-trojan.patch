index 0000000..5e1b1ce
--- /dev/null
+++ b/protocol/xraycore/protocols.go
@@ -0,0 +1,196 @@
+package xraycore
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// VMess and Trojan are native Xray protocols (owner decision 2026-11-16). Their share links are read here and
+// handed to Xray in its own JSON; the transport and TLS part is the same code as VLESS (streamFromQuery).
+
+var errVMessAlterID = errors.New("VMess with alterId > 0 (legacy protocol without AEAD) is not supported by Xray")
+
+func trojanOutbound(server string, port int, password string, stream object) object {
+	return object{
+		"tag": "proxy", "protocol": "trojan",
+		"settings":       object{"servers": []any{object{"address": server, "port": port, "password": password}}},
+		"streamSettings": stream,
+	}
+}
+
+func vmessOutbound(server string, port int, id, security string, stream object) object {
+	return object{
+		"tag": "proxy", "protocol": "vmess",
+		"settings": object{"vnext": []any{object{"address": server, "port": port, "users": []any{
+			object{"id": id, "security": security},
+		}}}},
+		"streamSettings": stream,
+	}
+}
+
+func trojanFromURI(raw string) (object, error) {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return nil, fmt.Errorf("invalid Trojan URI syntax")
+	}
+	if !strings.EqualFold(u.Scheme, "trojan") || u.User == nil || u.User.Username() == "" || u.Hostname() == "" {
+		return nil, fmt.Errorf("Trojan URI requires a password and server")
+	}
+	password := u.User.Username()
+	if rest, ok := u.User.Password(); ok {
+		password += ":" + rest // a password that itself contains ':'
+	}
+	q, err := singleValueQuery(u, "Trojan")
+	if err != nil {
+		return nil, err
+	}
+	port, err := serverPort(u, "Trojan")
+	if err != nil {
+		return nil, err
+	}
+	stream, err := streamFromQuery(q, u.Hostname(), "Trojan", "tls")
+	if err != nil {
+		return nil, err
+	}
+	return trojanOutbound(u.Hostname(), port, password, stream), nil
+}
+
+func singleValueQuery(u *url.URL, label string) (url.Values, error) {
+	q, err := url.ParseQuery(u.RawQuery)
+	if err != nil {
+		return nil, fmt.Errorf("invalid %s URI query", label)
+	}
+	for key, values := range q {
+		if len(values) != 1 {
+			return nil, fmt.Errorf("duplicate %s query parameter: %s", label, key)
+		}
+	}
+	return q, nil
+}
+
+func serverPort(u *url.URL, label string) (int, error) {
+	if u.Port() == "" {
+		return 443, nil
+	}
+	port, err := strconv.Atoi(u.Port())
+	if err != nil || port < 1 || port > 65535 {
+		return 0, fmt.Errorf("invalid %s server port", label)
+	}
+	return port, nil
+}
+
+// vmessFromURI reads the v2rayN link: vmess://base64(JSON). The JSON fields map onto the same query parameters the
+// other two protocols use, so the stream is built by the one shared function.
+func vmessFromURI(raw string) (object, error) {
+	body := raw[len("vmess://"):]
+	if hash := strings.IndexByte(body, '#'); hash >= 0 {
+		body = body[:hash]
+	}
+	var payload map[string]any
+	decoded := false
+	for _, decoder := range []*base64.Encoding{base64.StdEncoding, base64.RawStdEncoding, base64.URLEncoding, base64.RawURLEncoding} {
+		if data, err := decoder.DecodeString(strings.TrimSpace(body)); err == nil && json.Unmarshal(data, &payload) == nil {
+			decoded = true
+			break
+		}
+	}
+	if !decoded || payload == nil {
+		return nil, fmt.Errorf("invalid VMess URI: expected base64 JSON")
+	}
+	text := func(key string) string {
+		switch value := payload[key].(type) {
+		case string:
+			return strings.TrimSpace(value)
+		case float64:
+			return strconv.FormatFloat(value, 'f', -1, 64)
+		}
+		return ""
+	}
+	address, id := text("add"), text("id")
+	if address == "" || id == "" {
+		return nil, fmt.Errorf("VMess URI requires a server and an id")
+	}
+	port := 443
+	if text("port") != "" {
+		parsed, err := strconv.Atoi(text("port"))
+		if err != nil || parsed < 1 || parsed > 65535 {
+			return nil, fmt.Errorf("invalid VMess server port")
+		}
+		port = parsed
+	}
+	if alter := text("aid"); alter != "" && alter != "0" {
+		return nil, errVMessAlterID
+	}
+	security := text("scy")
+	if security == "" {
+		security = "auto"
+	}
+	network := strings.ToLower(text("net"))
+	if network == "" {
+		network = "tcp"
+	}
+	q := url.Values{"type": {network}}
+	set := func(name, value string) {
+		if value != "" {
+			q.Set(name, value)
+		}
+	}
+	switch tls := strings.ToLower(text("tls")); tls {
+	case "tls", "reality":
+		q.Set("security", tls)
+	default:
+		q.Set("security", "none")
+	}
+	set("host", text("host"))
+	set("path", text("path"))
+	set("sni", firstNonEmpty(text("sni"), text("host")))
+	set("alpn", text("alpn"))
+	set("fp", text("fp"))
+	set("pcs", firstNonEmpty(text("pcs"), text("pinnedPeerCertSha256")))
+	set("vcn", firstNonEmpty(text("vcn"), text("verifyPeerCertByName")))
+	for from, to := range map[string]string{"pbk": "pbk", "sid": "sid", "spx": "spx"} {
+		set(to, text(from))
+	}
+	// v2rayN keeps different things in one field "type": the header for tcp/kcp, the mode for xhttp,
+	// "multi" for gRPC; a gRPC service name travels in "path".
+	switch network {
+	case "xhttp", "splithttp":
+		set("mode", text("type"))
+		switch extra := payload["extra"].(type) {
+		case string:
+			set("extra", extra)
+		case map[string]any:
+			data, err := json.Marshal(extra)
+			if err != nil {
+				return nil, fmt.Errorf("invalid VMess XHTTP extra JSON")
+			}
+			q.Set("extra", string(data))
+		}
+	case "grpc":
+		set("serviceName", firstNonEmpty(text("serviceName"), text("path")))
+		if text("type") == "multi" {
+			q.Set("mode", "multi")
+		}
+	default:
+		set("headerType", text("type"))
+	}
+	stream, err := streamFromQuery(q, address, "VMess", "none")
+	if err != nil {
+		return nil, err
+	}
+	return vmessOutbound(address, port, id, security, stream), nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, value := range values {
+		if value != "" {
+			return value
+		}
+	}
+	return ""
+}
