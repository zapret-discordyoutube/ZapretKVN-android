+	for _, uri := range []string{"vmess://not-base64!!", "vmess://" + base64.StdEncoding.EncodeToString([]byte(`{"add":"h.example"}`))} {
+		if _, err = buildVMessConfig(option.VMessOutboundOptions{URI: uri}, "d"); err == nil {
+			t.Fatalf("%s must be refused", uri)
