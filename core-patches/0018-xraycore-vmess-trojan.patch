+// xrayAccepts runs a generated document through Xray's own parser and builder, the same way newXrayOutbound does.
+func xrayAccepts(t *testing.T, data []byte) map[string]any {
+	t.Helper()
+	document, err := serial.DecodeJSONConfig(bytes.NewReader(data))
+	if err != nil {
+		t.Fatalf("Xray rejected the document: %v\n%s", err, data)
+	}
+	if _, err = document.Build(); err != nil {
+		t.Fatalf("Xray rejected the document: %v\n%s", err, data)
+	}
+	var parsed struct {
+		Outbounds []map[string]any `json:"outbounds"`
+	}
+	if err = json.Unmarshal(data, &parsed); err != nil || len(parsed.Outbounds) != 1 {
+		t.Fatal(err)
+	}
+	return parsed.Outbounds[0]
+}
+
+func trojanDocument(t *testing.T, uri string) map[string]any {
+	t.Helper()
+	data, err := buildTrojanConfig(option.TrojanOutboundOptions{URI: uri}, "test-dialer")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return xrayAccepts(t, data)
+}
+
+func vmessLink(payload map[string]any) string {
+	data, _ := json.Marshal(payload)
+	return "vmess://" + base64.StdEncoding.EncodeToString(data) + "#name"
+}
+
+func vmessDocument(t *testing.T, payload map[string]any) map[string]any {
+	t.Helper()
+	data, err := buildVMessConfig(option.VMessOutboundOptions{URI: vmessLink(payload)}, "test-dialer")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return xrayAccepts(t, data)
+}
+
+func TestTrojanURIBecomesAnXrayTrojanOutbound(t *testing.T) {
+	outbound := trojanDocument(t, "trojan://p%40ss:word@vpn.example.com:8443?type=xhttp&sni=front.example&path=%2Fapi&host=cdn.example&mode=packet-up&extra=%7B%22xPaddingObfsMode%22%3Atrue%7D")
+	if outbound["protocol"] != "trojan" {
+		t.Fatalf("protocol = %v", outbound["protocol"])
+	}
+	server := outbound["settings"].(map[string]any)["servers"].([]any)[0].(map[string]any)
+	if server["address"] != "vpn.example.com" || server["port"] != float64(8443) || server["password"] != "p@ss:word" {
+		t.Fatalf("server = %v", server)
+	}
+	stream := outbound["streamSettings"].(map[string]any)
+	if stream["security"] != "tls" {
+		t.Fatalf("Trojan defaults to TLS, got %v", stream["security"])
+	}
+	if stream["tlsSettings"].(map[string]any)["serverName"] != "front.example" {
+		t.Fatalf("tlsSettings = %v", stream["tlsSettings"])
+	}
+	xhttp := stream["xhttpSettings"].(map[string]any)
+	want := map[string]any{"host": "cdn.example", "path": "/api", "mode": "packet-up", "extra": map[string]any{"xPaddingObfsMode": true}}
+	if !reflect.DeepEqual(xhttp, want) {
+		t.Fatalf("xhttpSettings = %v, want %v", xhttp, want)
+	}
+	if stream["sockopt"].(map[string]any)["interface"] != "test-dialer" {
+		t.Fatalf("socket is not bound to the protected dialer: %v", stream["sockopt"])
+	}
+}
+
+func TestTrojanURIKeepsPinAndRefusesBadInput(t *testing.T) {
+	pin := strings.Repeat("ab", 32)
+	outbound := trojanDocument(t, "trojan://pw@vpn.example.com:443?security=tls&allowInsecure=1&pcs="+pin)
+	tls := outbound["streamSettings"].(map[string]any)["tlsSettings"].(map[string]any)
+	if tls["pinnedPeerCertSha256"] != pin || tls["allowInsecure"] != nil {
+		t.Fatalf("pin must replace allowInsecure: %v", tls)
+	}
+	for _, uri := range []string{"trojan://@vpn.example.com:443", "trojan://pw@:443", "trojan://pw@vpn.example.com:99999", "trojan://pw@vpn.example.com:443?type=http"} {
+		if _, err := buildTrojanConfig(option.TrojanOutboundOptions{URI: uri}, "d"); err == nil {
+			t.Fatalf("%s must be refused", uri)
+		}
+	}
+}
+
+func TestVMessURIBecomesAnXrayVMessOutbound(t *testing.T) {
+	outbound := vmessDocument(t, map[string]any{
+		"add": "vpn.example.com", "port": 443, "id": vmessID, "aid": "0", "scy": "chacha20-poly1305", "net": "xhttp",
+		"type": "packet-up", "host": "cdn.example", "path": "/v", "tls": "tls", "sni": "front.example",
+		"extra": map[string]any{"uplinkHTTPMethod": "GET"},
+	})
+	user := outbound["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
+	if user["id"] != vmessID || user["security"] != "chacha20-poly1305" {
+		t.Fatalf("user = %v", user)
+	}
+	xhttp := outbound["streamSettings"].(map[string]any)["xhttpSettings"].(map[string]any)
+	want := map[string]any{"host": "cdn.example", "path": "/v", "mode": "packet-up", "extra": map[string]any{"uplinkHTTPMethod": "GET"}}
+	if !reflect.DeepEqual(xhttp, want) {
+		t.Fatalf("xhttpSettings = %v, want %v", xhttp, want)
+	}
+}
+
+func TestVMessURITransportsAndDefaults(t *testing.T) {
+	grpc := vmessDocument(t, map[string]any{"add": "vpn.example.com", "port": "443", "id": vmessID, "net": "grpc", "path": "svc", "tls": "tls"})
+	stream := grpc["streamSettings"].(map[string]any)
+	if stream["grpcSettings"].(map[string]any)["serviceName"] != "svc" {
+		t.Fatalf("gRPC service name comes from path: %v", stream["grpcSettings"])
+	}
+	plain := vmessDocument(t, map[string]any{"add": "vpn.example.com", "port": 8080, "id": vmessID, "net": "tcp"})
+	if plain["streamSettings"].(map[string]any)["security"] != "none" {
+		t.Fatalf("no tls field means no TLS: %v", plain["streamSettings"])
+	}
+	user := plain["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
+	if user["security"] != "auto" {
+		t.Fatalf("default VMess security: %v", user["security"])
+	}
+}
