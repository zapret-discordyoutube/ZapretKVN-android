+func TestVMessAlterIDAndBrokenLinksAreRefused(t *testing.T) {
+	_, err := buildVMessConfig(option.VMessOutboundOptions{URI: vmessLink(map[string]any{"add": "h.example", "port": 443, "id": vmessID, "aid": "4"})}, "d")
+	if !errors.Is(err, errVMessAlterID) {
+		t.Fatalf("alterId > 0 must be refused, got %v", err)
