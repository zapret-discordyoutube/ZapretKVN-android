+// ProxyTraffic — итоги только через прокси для детектора обрыва (см. trafficcontrol.Manager.ProxyTotal).
+func (s *StartedService) ProxyTraffic() (uplinkTotal int64, downlinkTotal int64, active int32, available bool) {
+	s.serviceAccess.RLock()
+	nowService := s.instance
+	s.serviceAccess.RUnlock()
+	if nowService == nil || nowService.trafficManager == nil {
+		return 0, 0, 0, false
+	}
+	uplinkTotal, downlinkTotal, active = nowService.trafficManager.ProxyTotal()
+	return uplinkTotal, downlinkTotal, active, true
+}
