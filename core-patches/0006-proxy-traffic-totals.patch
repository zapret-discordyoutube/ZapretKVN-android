+
+// IsProxyOutboundType: соединение идёт через прокси, а не напрямую, не в block и не в DNS.
+func IsProxyOutboundType(outboundType string) bool {
+	switch outboundType {
+	case "", "direct", "block", "dns":
+		return false
+	default:
+		return true
+	}
+}
+
+func (m *Manager) addClosedProxyLocked(metadata TrackerMetadata) {
+	if !IsProxyOutboundType(metadata.OutboundType) {
+		return
+	}
+	m.closedProxyUploadTotal += metadata.Upload.Load()
+	m.closedProxyDownloadTotal += metadata.Download.Load()
+}
+
+// ProxyTotal — байты (накопительно за сессию) и число активных соединений только
+// через прокси. Прямой трафик в общих итогах маскирует мёртвый прокси для
+// детектора «подключено, но данные не идут» на стороне приложения. Один проход по
+// соединениям, как у Total; отдельного потока событий не требует.
+func (m *Manager) ProxyTotal() (uplinkTotal int64, downlinkTotal int64, active int32) {
+	m.closedConnectionsAccess.Lock()
+	defer m.closedConnectionsAccess.Unlock()
+	uplinkTotal = m.closedProxyUploadTotal
+	downlinkTotal = m.closedProxyDownloadTotal
+	for element := m.closedConnections.Front(); element != nil; element = element.Next() {
+		if IsProxyOutboundType(element.Value.OutboundType) {
+			uplinkTotal += element.Value.Upload.Load()
+			downlinkTotal += element.Value.Download.Load()
+		}
+	}
+	m.connections.Range(func(_ uuid.UUID, tracker Tracker) bool {
+		metadata := tracker.Metadata()
+		if IsProxyOutboundType(metadata.OutboundType) {
+			uplinkTotal += metadata.Upload.Load()
+			downlinkTotal += metadata.Download.Load()
+			active++
+		}
+		return true
+	})
+	return
+}
diff --git a/common/trafficcontrol/proxy_total_test.go b/common/trafficcontrol/proxy_total_test.go
new file mode 100644
index 0000000..1118fda
--- /dev/null
+++ b/common/trafficcontrol/proxy_total_test.go
@@ -0,0 +1,67 @@
+package trafficcontrol
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+func trackerWith(m *Manager, outboundType string, up int64, down int64) *connTracker {
+	id, _ := uuid.NewV4()
+	upload, download := new(atomic.Int64), new(atomic.Int64)
+	upload.Store(up)
+	download.Store(down)
+	tracker := &connTracker{
+		metadata: TrackerMetadata{ID: id, OutboundType: outboundType, Upload: upload, Download: download},
+		manager:  m,
+	}
+	m.join(tracker)
+	return tracker
+}
+
+func TestProxyTotalExcludesDirectBlockAndDNS(t *testing.T) {
+	m := NewManager(nil)
+	trackerWith(m, "hysteria2", 100, 1000)
+	trackerWith(m, "direct", 50, 9000)
+	trackerWith(m, "dns", 1, 1)
+	trackerWith(m, "block", 1, 1)
+	up, down, active := m.ProxyTotal()
+	if up != 100 || down != 1000 || active != 1 {
+		t.Fatalf("ProxyTotal = %d/%d/%d, want 100/1000/1", up, down, active)
+	}
+}
+
+func TestProxyTotalKeepsClosedProxyBytesAfterEviction(t *testing.T) {
+	m := NewManager(nil)
+	m.closedConnections.PushBack(TrackerMetadata{OutboundType: "vless", Upload: atomicOf(7), Download: atomicOf(70)})
+	m.closedConnections.PushBack(TrackerMetadata{OutboundType: "direct", Upload: atomicOf(5), Download: atomicOf(500)})
+	m.Clear()
+	up, down, active := m.ProxyTotal()
+	if up != 7 || down != 70 || active != 0 {
+		t.Fatalf("ProxyTotal after clear = %d/%d/%d, want 7/70/0", up, down, active)
+	}
+	totalUp, totalDown := m.Total()
+	if totalUp != 12 || totalDown != 570 {
+		t.Fatalf("Total after clear = %d/%d, want 12/570", totalUp, totalDown)
+	}
+}
+
+func atomicOf(value int64) *atomic.Int64 {
+	result := new(atomic.Int64)
+	result.Store(value)
+	return result
+}
+
+func TestIsProxyOutboundType(t *testing.T) {
+	for _, value := range []string{"", "direct", "block", "dns"} {
+		if IsProxyOutboundType(value) {
+			t.Fatalf("%q must not be proxy", value)
+		}
+	}
+	for _, value := range []string{"selector", "hysteria2", "vless", "wireguard"} {
+		if !IsProxyOutboundType(value) {
+			t.Fatalf("%q must be proxy", value)
+		}
+	}
+}
