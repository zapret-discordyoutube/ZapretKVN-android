diff --git a/transport/wireguard/android_client_bind.go b/transport/wireguard/android_client_bind.go
new file mode 100644
index 00000000..5c151c82
--- /dev/null
+++ b/transport/wireguard/android_client_bind.go
@@ -0,0 +1,231 @@
+package wireguard
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	awgConn "github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	metaConn "github.com/metacubex/wireguard-go/conn"
+	"github.com/sagernet/sing/common/bufio"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var _ metaConn.Bind = (*AndroidClientBind)(nil)
+
+// AndroidClientBind always uses the protected sing-box dialer. It avoids the
+// platform UDP batching/GRO path while retaining one Android VpnService TUN.
+type AndroidClientBind struct {
+	ctx         context.Context
+	logger      logger.Logger
+	dialer      N.Dialer
+	bindCtx     context.Context
+	bindDone    context.CancelFunc
+	connAccess  sync.Mutex
+	conn        net.PacketConn
+	closed      atomic.Bool
+	lastLogNano atomic.Int64
+	isConnect   bool
+	connectAddr netip.AddrPort
+}
+
+func NewAndroidClientBind(ctx context.Context, logger logger.Logger, dialer N.Dialer, peers []peerConfig) *AndroidClientBind {
+	bind := &AndroidClientBind{ctx: ctx, logger: logger, dialer: dialer}
+	if len(peers) == 1 && peers[0].endpoint.IsValid() {
+		bind.isConnect = true
+		bind.connectAddr = peers[0].endpoint
+	}
+	return bind
+}
+
+func (b *AndroidClientBind) Open(uint16) ([]metaConn.ReceiveFunc, uint16, error) {
+	b.closed.Store(false)
+	b.bindCtx, b.bindDone = context.WithCancel(b.ctx)
+	return []metaConn.ReceiveFunc{b.receive}, 0, nil
+}
+
+func (b *AndroidClientBind) connect() (net.PacketConn, error) {
+	b.connAccess.Lock()
+	defer b.connAccess.Unlock()
+	if b.closed.Load() {
+		return nil, net.ErrClosed
+	}
+	if b.conn != nil {
+		return b.conn, nil
+	}
+	if b.isConnect {
+		conn, err := b.dialer.DialContext(b.bindCtx, N.NetworkUDP, M.SocksaddrFromNetIP(b.connectAddr))
+		if err != nil {
+			return nil, err
+		}
+		b.conn = bufio.NewUnbindPacketConn(conn)
+	} else {
+		conn, err := b.dialer.ListenPacket(b.bindCtx, M.Socksaddr{Addr: netip.IPv4Unspecified()})
+		if err != nil {
+			return nil, err
+		}
+		b.conn = bufio.NewPacketConn(conn)
+	}
+	return b.conn, nil
+}
+
+func (b *AndroidClientBind) receive(packets [][]byte, sizes []int, endpoints []metaConn.Endpoint) (int, error) {
+	return b.receiveCore(packets, sizes, func(index int, endpoint androidEndpoint) {
+		endpoints[index] = endpoint
+	})
+}
+
+// receiveCore is engine-agnostic: the vanilla metacubex bind and the official
+// Amnezia bind wrap it with their own endpoint slice types.
+func (b *AndroidClientBind) receiveCore(packets [][]byte, sizes []int, setEndpoint func(int, androidEndpoint)) (int, error) {
+	conn, err := b.connect()
+	if err != nil {
+		if b.closed.Load() {
+			return 0, net.ErrClosed
+		}
+		b.logError(E.Cause(err, "connect to wireguard server"))
+		b.waitRetry()
+		return 0, nil
+	}
+	n, address, err := conn.ReadFrom(packets[0])
+	if err != nil {
+		b.dropConn(conn)
+		if b.closed.Load() {
+			return 0, net.ErrClosed
+		}
+		b.logError(E.Cause(err, "read wireguard packet"))
+		b.waitRetry()
+		return 0, nil
+	}
+	sizes[0] = n
+	setEndpoint(0, androidEndpoint(M.SocksaddrFromNet(address).Unwrap().AddrPort()))
+	return 1, nil
+}
+
+func (b *AndroidClientBind) Close() error {
+	if b.closed.Swap(true) {
+		return nil
+	}
+	if b.bindDone != nil {
+		b.bindDone()
+	}
+	b.connAccess.Lock()
+	defer b.connAccess.Unlock()
+	if b.conn != nil {
+		_ = b.conn.Close()
+		b.conn = nil
+	}
+	return nil
+}
+
+func (b *AndroidClientBind) SetMark(uint32) error { return nil }
+
+func (b *AndroidClientBind) Send(buffers [][]byte, endpoint metaConn.Endpoint) error {
+	return b.sendCore(buffers, netip.AddrPort(endpoint.(androidEndpoint)))
+}
+
+func (b *AndroidClientBind) sendCore(buffers [][]byte, destination netip.AddrPort) error {
+	conn, err := b.connect()
+	if err != nil {
+		return err
+	}
+	for _, buffer := range buffers {
+		if _, err = conn.WriteTo(buffer, net.UDPAddrFromAddrPort(destination)); err != nil {
+			b.dropConn(conn)
+			return err
+		}
+	}
+	return nil
+}
+
+func (b *AndroidClientBind) ParseEndpoint(value string) (metaConn.Endpoint, error) {
+	address, err := netip.ParseAddrPort(value)
+	return androidEndpoint(address), err
+}
+
+func (b *AndroidClientBind) BatchSize() int { return 1 }
+
+func (b *AndroidClientBind) waitRetry() {
+	timer := time.NewTimer(time.Second)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+	case <-b.bindCtx.Done():
+	}
+}
+
+func (b *AndroidClientBind) logError(err error) {
+	now := time.Now().UnixNano()
+	previous := b.lastLogNano.Load()
+	if now-previous < int64(10*time.Second) || !b.lastLogNano.CompareAndSwap(previous, now) {
+		return
+	}
+	b.logger.Error(err)
+}
+
+func (b *AndroidClientBind) dropConn(conn net.PacketConn) {
+	b.connAccess.Lock()
+	defer b.connAccess.Unlock()
+	if b.conn == conn {
+		_ = b.conn.Close()
+		b.conn = nil
+	}
+}
+
+var _ awgConn.Bind = androidAmneziaBind{}
+
+// androidAmneziaBind exposes the same protected-dialer bind to the official
+// amnezia-vpn/amneziawg-go v3 engine. Go cannot let one type implement two
+// structurally identical Bind interfaces from different packages, so this
+// thin wrapper only converts the package-typed slices.
+type androidAmneziaBind struct {
+	bind *AndroidClientBind
+}
+
+func (b androidAmneziaBind) Open(port uint16) ([]awgConn.ReceiveFunc, uint16, error) {
+	_, actualPort, err := b.bind.Open(port)
+	if err != nil {
+		return nil, 0, err
+	}
+	receive := func(packets [][]byte, sizes []int, endpoints []awgConn.Endpoint) (int, error) {
+		return b.bind.receiveCore(packets, sizes, func(index int, endpoint androidEndpoint) {
+			endpoints[index] = endpoint
+		})
+	}
+	return []awgConn.ReceiveFunc{receive}, actualPort, nil
+}
+
+func (b androidAmneziaBind) Close() error        { return b.bind.Close() }
+func (b androidAmneziaBind) SetMark(mark uint32) error { return b.bind.SetMark(mark) }
+
+func (b androidAmneziaBind) Send(buffers [][]byte, endpoint awgConn.Endpoint) error {
+	return b.bind.sendCore(buffers, netip.AddrPort(endpoint.(androidEndpoint)))
+}
+
+func (b androidAmneziaBind) ParseEndpoint(value string) (awgConn.Endpoint, error) {
+	address, err := netip.ParseAddrPort(value)
+	return androidEndpoint(address), err
+}
+
+func (b androidAmneziaBind) BatchSize() int { return 1 }
+
+var _ metaConn.Endpoint = androidEndpoint{}
+var _ awgConn.Endpoint = androidEndpoint{}
+
+type androidEndpoint netip.AddrPort
+
+func (e androidEndpoint) ClearSrc()           {}
+func (e androidEndpoint) SrcToString() string { return "" }
+func (e androidEndpoint) DstToString() string { return netip.AddrPort(e).String() }
+func (e androidEndpoint) DstToBytes() []byte {
+	value, _ := netip.AddrPort(e).MarshalBinary()
+	return value
+}
+func (e androidEndpoint) DstIP() netip.Addr { return netip.AddrPort(e).Addr() }
+func (e androidEndpoint) SrcIP() netip.Addr { return netip.Addr{} }
diff --git a/transport/wireguard/android_client_bind_test.go b/transport/wireguard/android_client_bind_test.go
new file mode 100644
index 00000000..5a835582
--- /dev/null
+++ b/transport/wireguard/android_client_bind_test.go
@@ -0,0 +1,130 @@
+package wireguard
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	metaConn "github.com/metacubex/wireguard-go/conn"
+	metaTun "github.com/metacubex/wireguard-go/tun"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAndroidClientBindConnectedRoundTrip(t *testing.T) {
+	connection := newTestPacketConnection()
+	bind := NewAndroidClientBind(
+		context.Background(),
+		logger.NOP(),
+		testDialer{connection: connection},
+		[]peerConfig{{endpoint: netip.MustParseAddrPort("192.0.2.1:51820")}},
+	)
+	receivers, _, err := bind.Open(0)
+	require.NoError(t, err)
+	require.Equal(t, 1, bind.BatchSize())
+
+	endpoint, err := bind.ParseEndpoint("192.0.2.1:51820")
+	require.NoError(t, err)
+	require.NoError(t, bind.Send([][]byte{[]byte("outbound")}, endpoint))
+	require.Equal(t, []byte("outbound"), <-connection.writes)
+
+	connection.reads <- []byte("inbound")
+	packets := [][]byte{make([]byte, 64)}
+	sizes := make([]int, 1)
+	endpoints := make([]metaConn.Endpoint, 1)
+	count, err := receivers[0](packets, sizes, endpoints)
+	require.NoError(t, err)
+	require.Equal(t, 1, count)
+	require.Equal(t, []byte("inbound"), packets[0][:sizes[0]])
+	require.Equal(t, "192.0.2.1:51820", endpoints[0].DstToString())
+	require.NoError(t, bind.Close())
+	require.NoError(t, bind.Close())
+}
+
+func TestAndroidWireGuardEngineActivatesTunExplicitly(t *testing.T) {
+	tun := &androidTunAdapter{events: make(chan metaTun.Event, 1)}
+	engine := &androidWireGuardEngine{wireGuardEngine: testWireGuardEngine{}, tun: tun}
+	select {
+	case <-tun.events:
+		t.Fatal("TUN became active before IPC configuration")
+	default:
+	}
+	engine.activate()
+	require.Equal(t, metaTun.Event(metaTun.EventUp), <-tun.events)
+}
+
+type testWireGuardEngine struct{}
+
+func (testWireGuardEngine) IpcSet(string) error                         { return nil }
+func (testWireGuardEngine) Up() error                                   { return nil }
+func (testWireGuardEngine) Down() error                                 { return nil }
+func (testWireGuardEngine) Close()                                      {}
+func (testWireGuardEngine) DisableSomeRoamingForBrokenMobileSemantics() {}
+
+type testDialer struct{ connection net.Conn }
+
+func (d testDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return d.connection, nil
+}
+
+func (d testDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, io.ErrUnexpectedEOF
+}
+
+type testPacketConnection struct {
+	reads  chan []byte
+	writes chan []byte
+	closed chan struct{}
+}
+
+func newTestPacketConnection() *testPacketConnection {
+	return &testPacketConnection{
+		reads:  make(chan []byte, 1),
+		writes: make(chan []byte, 1),
+		closed: make(chan struct{}),
+	}
+}
+
+func (c *testPacketConnection) Read(buffer []byte) (int, error) {
+	select {
+	case packet := <-c.reads:
+		return copy(buffer, packet), nil
+	case <-c.closed:
+		return 0, net.ErrClosed
+	}
+}
+
+func (c *testPacketConnection) Write(buffer []byte) (int, error) {
+	copyBuffer := append([]byte(nil), buffer...)
+	select {
+	case c.writes <- copyBuffer:
+		return len(buffer), nil
+	case <-c.closed:
+		return 0, net.ErrClosed
+	}
+}
+
+func (c *testPacketConnection) Close() error {
+	select {
+	case <-c.closed:
+	default:
+		close(c.closed)
+	}
+	return nil
+}
+
+func (c *testPacketConnection) LocalAddr() net.Addr              { return testAddress("192.0.2.2:12345") }
+func (c *testPacketConnection) RemoteAddr() net.Addr             { return testAddress("192.0.2.1:51820") }
+func (c *testPacketConnection) SetDeadline(time.Time) error      { return nil }
+func (c *testPacketConnection) SetReadDeadline(time.Time) error  { return nil }
+func (c *testPacketConnection) SetWriteDeadline(time.Time) error { return nil }
+
+type testAddress string
+
+func (a testAddress) Network() string { return "udp" }
+func (a testAddress) String() string  { return string(a) }
diff --git a/transport/wireguard/android_engine.go b/transport/wireguard/android_engine.go
new file mode 100644
index 00000000..027a215c
--- /dev/null
+++ b/transport/wireguard/android_engine.go
@@ -0,0 +1,123 @@
+package wireguard
+
+import (
+	"sync"
+
+	awgDevice "github.com/amnezia-vpn/amneziawg-go/v3/device"
+	awgTun "github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	metaDevice "github.com/metacubex/wireguard-go/device"
+	metaTun "github.com/metacubex/wireguard-go/tun"
+	sagerDevice "github.com/sagernet/wireguard-go/device"
+)
+
+// wireGuardEngine is the common lifecycle shared by the pinned sing-box
+// engine and the Android vanilla/Amnezia engines. Keeping it here avoids a
+// second Android TUN or a local proxy hop.
+type wireGuardEngine interface {
+	IpcSet(string) error
+	Up() error
+	Down() error
+	Close()
+	BindUpdate() error
+	DisableSomeRoamingForBrokenMobileSemantics()
+}
+
+// NewAndroidWireGuardEngine keeps the split data plane: vanilla WireGuard
+// runs on metacubex/wireguard-go, while every AmneziaWG generation
+// (1.5/2.0/3.0) runs on the official amnezia-vpn/amneziawg-go v3 engine —
+// the same protocol line as the server fleet, including AWG 3.0 header
+// protection and content padding delivered over the same UAPI keys the
+// pinned core writes.
+func NewAndroidWireGuardEngine(
+	tunDevice Device,
+	bind *AndroidClientBind,
+	logger *sagerDevice.Logger,
+	useAmnezia bool,
+	workers int,
+) wireGuardEngine {
+	if useAmnezia {
+		adapter := newAndroidAmneziaTunAdapter(tunDevice)
+		engine := awgDevice.NewDevice(
+			adapter,
+			androidAmneziaBind{bind: bind},
+			&awgDevice.Logger{Verbosef: logger.Verbosef, Errorf: logger.Errorf},
+		)
+		engine.DisableSomeRoamingForBrokenMobileSemantics()
+		return &androidAmneziaEngine{Device: engine, tun: adapter}
+	}
+	adapter := newAndroidTunAdapter(tunDevice)
+	metaLogger := &metaDevice.Logger{Verbosef: logger.Verbosef, Errorf: logger.Errorf}
+	engine := metaDevice.NewDevice(adapter, bind, metaLogger, workers)
+	engine.DisableSomeRoamingForBrokenMobileSemantics()
+	return &androidWireGuardEngine{wireGuardEngine: engine, tun: adapter}
+}
+
+// androidEngineActivator marks engines whose adapter must observe EventUp
+// after IpcSet, mirroring the platform TUN lifecycle.
+type androidEngineActivator interface {
+	activate()
+}
+
+type androidWireGuardEngine struct {
+	wireGuardEngine
+	tun *androidTunAdapter
+}
+
+func (e *androidWireGuardEngine) activate() {
+	e.tun.events <- metaTun.EventUp
+}
+
+type androidAmneziaEngine struct {
+	*awgDevice.Device
+	tun *androidAmneziaTunAdapter
+}
+
+func (e *androidAmneziaEngine) activate() {
+	e.tun.events <- awgTun.EventUp
+}
+
+type androidTunAdapter struct {
+	Device
+	events chan metaTun.Event
+	close  sync.Once
+}
+
+func newAndroidTunAdapter(device Device) *androidTunAdapter {
+	return &androidTunAdapter{Device: device, events: make(chan metaTun.Event, 1)}
+}
+
+func (a *androidTunAdapter) Events() <-chan metaTun.Event {
+	return a.events
+}
+
+func (a *androidTunAdapter) Close() error {
+	var err error
+	a.close.Do(func() {
+		close(a.events)
+		err = a.Device.Close()
+	})
+	return err
+}
+
+type androidAmneziaTunAdapter struct {
+	Device
+	events chan awgTun.Event
+	close  sync.Once
+}
+
+func newAndroidAmneziaTunAdapter(device Device) *androidAmneziaTunAdapter {
+	return &androidAmneziaTunAdapter{Device: device, events: make(chan awgTun.Event, 1)}
+}
+
+func (a *androidAmneziaTunAdapter) Events() <-chan awgTun.Event {
+	return a.events
+}
+
+func (a *androidAmneziaTunAdapter) Close() error {
+	var err error
+	a.close.Do(func() {
+		close(a.events)
+		err = a.Device.Close()
+	})
+	return err
+}
