+func (e *Endpoint) resolveAndroidPeers() error {
+	for peerIndex, peer := range e.peers {
+		if peer.endpoint.IsValid() || !peer.destination.IsDomain() {
+			continue
+		}
+		addresses, err := e.options.ResolvePeer(peer.destination.Fqdn)
