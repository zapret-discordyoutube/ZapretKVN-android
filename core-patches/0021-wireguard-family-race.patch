+		if familymemory.Default.PreferIPv6(name, true) {
+			return netip.AddrPortFrom(ipv6, port), netip.AddrPortFrom(ipv4, port)
+		}
+		return netip.AddrPortFrom(ipv4, port), netip.AddrPortFrom(ipv6, port)
+	}
+	onLock := func(address netip.AddrPort) {
+		familymemory.Default.Succeeded(name, address.Addr())
+		family := "IPv4"
+		if address.Addr().Is6() {
+			family = "IPv6"
+		}
+		logger.Info("wireguard: server answered over ", family, ", keeping it for this session")
+	}
+	logger.Info("wireguard: first handshake goes to the server over IPv6 and IPv4, the first answer wins")
+	return newFamilyRace(order, onLock, nil)
+}
