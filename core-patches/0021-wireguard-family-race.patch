+// the name has one family only. The family that last answered for this name
+// (common/familymemory, reset on network change) leads the race.
+func (e *Endpoint) newFamilyRace(destination M.Socksaddr, addresses []netip.Addr) *familyRace {
+	if !e.options.PreferIPv6 || len(e.peers) != 1 || e.options.ListenPort != 0 {
+		return nil
+	}
