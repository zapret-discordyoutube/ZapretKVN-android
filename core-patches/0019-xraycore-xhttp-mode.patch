diff --git a/protocol/xraycore/protocols_test.go b/protocol/xraycore/protocols_test.go
index f1c57a21..9507cebe 100644
--- a/protocol/xraycore/protocols_test.go
+++ b/protocol/xraycore/protocols_test.go
@@ -214,3 +214,22 @@ func TestLegacyTrojanAndVMessProfiles(t *testing.T) {
 		t.Fatalf("legacy multiplex must ask for the link, got %v", err)
 	}
 }
+
+// v2rayN keeps the header type in "type" ("none" by default) and the XHTTP mode in the same field. Xray accepts
+// only auto, packet-up, stream-up and stream-one (infra/conf/transport_method.go), so a header value must not
+// become the mode: "unsupported mode: none" stopped the whole profile (field report 2026-11-19).
+func TestVMessXHTTPHeaderTypeIsNotAMode(t *testing.T) {
+	for _, header := range []string{"none", "", "http", "Packet-Up"} {
+		outbound := vmessDocument(t, map[string]any{
+			"add": "vpn.example.com", "port": 443, "id": vmessID, "net": "xhttp", "type": header, "path": "/v", "tls": "tls",
+		})
+		mode := outbound["streamSettings"].(map[string]any)["xhttpSettings"].(map[string]any)["mode"]
+		want := "auto"
+		if header == "Packet-Up" {
+			want = "packet-up"
+		}
+		if mode != want {
+			t.Fatalf("type %q: mode = %v, want %s", header, mode, want)
+		}
+	}
+}
