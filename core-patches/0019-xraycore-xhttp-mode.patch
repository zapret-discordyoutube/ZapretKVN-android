--- a/protocol/xraycore/config.go
+++ b/protocol/xraycore/config.go
@@ -243,7 +243,7 @@ func streamFromQuery(q url.Values, hostname, label, defaultSecurity string) (obj
 	case "xhttp", "splithttp":
 		transport["host"] = q.Get("host")
 		transport["path"] = value("path", "/")
-		transport["mode"] = value("mode", "auto")
+		transport["mode"] = xhttpMode(q.Get("mode"))
 		if q.Has("extra") {
 			extraBytes := []byte(q.Get("extra"))
 			if !json.Valid(extraBytes) {
@@ -472,3 +472,17 @@ func legacyStream(label string, multiplex *option.OutboundMultiplexOptions, tlsO
 	}
 	return stream, nil
 }
+
+// xhttpModes are the XHTTP modes Xray accepts (infra/conf/transport_method.go); any other value stops the whole
+// profile with "unsupported mode".
+var xhttpModes = map[string]bool{"auto": true, "packet-up": true, "stream-up": true, "stream-one": true}
+
+// xhttpMode keeps a link mode only when it names an Xray mode (any case) and otherwise uses "auto", as v2rayN
+// does (V2rayOutboundService: the mode is passed only when Global.XhttpMode contains it). Links carry "none"
+// there: the header default of the shared v2rayN field.
+func xhttpMode(raw string) string {
+	if mode := strings.ToLower(strings.TrimSpace(raw)); xhttpModes[mode] {
+		return mode
+	}
+	return "auto"
+}
diff --git a/protocol/xraycore/config_test.go b/protocol/xraycore/config_test.go
