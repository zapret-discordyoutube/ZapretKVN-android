+++ b/protocol/xraycore/config_test.go
@@ -255,3 +255,15 @@ func TestLegacyInsecureTLSAsksForTheLink(t *testing.T) {
 		t.Fatalf("legacy insecure TLS: %v", err)
 	}
 }
+
+// A link mode Xray does not know falls back to auto, as in v2rayN, instead of stopping the profile with
+// Xray's "unsupported mode"; the case of a known mode does not matter.
+func TestURIXHTTPModeIsNormalised(t *testing.T) {
+	const base = "vless://b831381d-6324-4d53-ad4f-8cda48b30811@192.168.1.10:443?type=xhttp&security=none&path=/x&mode="
+	for raw, want := range map[string]string{"Stream-One": "stream-one", "none": "auto", "": "auto", "gun": "auto", "packet-up": "packet-up"} {
+		stream, _, _ := xrayStream(t, option.VLESSOutboundOptions{URI: base + raw})
+		if mode := stream["xhttpSettings"].(map[string]any)["mode"]; mode != want {
+			t.Fatalf("mode %q = %v, want %s", raw, mode, want)
+		}
+	}
+}
