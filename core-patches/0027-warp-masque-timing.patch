+
+// adopt installs the tunnel the start walk ended on, with everything the rotation needs later. lastSuccess stays zero: the
+// start probe passing says nothing about the tunnel carrying anything later (a network that cuts the flow after the
+// handshake passes it, field 2026-11-26), so no quiet period protects the tunnel until a real connection succeeded.
+func (w *Endpoint) adopt(
+	inner adapter.Endpoint,
+	position int,
+	list []candidate,
+	build func(candidate) (adapter.Endpoint, error),
+	scope *adapter.Scope,
+	remember func(candidate),
+) {
+	w.hopAccess.Lock()
+	defer w.hopAccess.Unlock()
+	w.endpoint, w.position = inner, position
+	w.list, w.build, w.scope, w.remember = list, build, scope, remember
+	w.lastSuccess = time.Time{}
+}
