+func TestTheStartProbePassingGivesNoQuietPeriod(t *testing.T) {
+	logger := log.NewNOPFactory().Logger()
+	hop := &Endpoint{ctx: context.Background(), logger: logger, await: make(chan struct{})}
+	hop.lastSuccess = time.Now() // whatever an earlier tunnel left
+	first := &fakeTunnel{name: "wireguard"}
+	list := []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}
+	hop.adopt(first, 0, list, func(candidate) (adapter.Endpoint, error) { return nil, errors.New("unused") }, adapter.NewScope(context.Background(), logger), nil)
+	if !hop.lastSuccess.IsZero() {
+		t.Fatal("a tunnel that only passed the start probe must not be protected by a quiet period")
+	}
+	if hop.active() != adapter.Endpoint(first) || len(hop.list) != 2 || hop.build == nil || hop.scope == nil {
+		t.Fatal("the hop did not take over what the start walk gave it")
+	}
+}
+
+func TestAMasqueAccountThatIsNotOnDiskGetsALongerProbe(t *testing.T) {
+	directory := t.TempDir()
+	hop := &Endpoint{}
+	hop.options.Profile.CachePath = filepath.Join(directory, "warp-entry-profile.json")
+	masque := candidate{transport: transportMasqueQUIC}
+	if got := hop.probeTimeoutFor(masque); got != masqueFirstProbeTimeout {
+		t.Fatalf("an unregistered MASQUE account needs the long probe, got %v", got)
+	}
+	if err := os.WriteFile(masqueAccountPath(hop.options.Profile.CachePath), []byte("{}"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := hop.probeTimeoutFor(masque); got != masqueProbeTimeout {
+		t.Fatalf("a registered account connects fast, got %v", got)
+	}
+	if got := hop.probeTimeoutFor(wireGuardCandidate("198.51.100.1", 2408)); got != probeTimeout {
+		t.Fatalf("WireGuard keeps its own probe, got %v", got)
+	}
+}
