+//go:build !with_naive_outbound || !unix
+
+package libbox
+
+type BrowserSocketProtector interface {
+	Protect(fd int32) bool
+}
+
+// Без Cronet браузерного транспорта нет (BrowserFetch отвечает unavailable),
+// защищать и резолвить нечего.
+func SetBrowserSocketProtector(BrowserSocketProtector) error { return nil }
+
+type BrowserResolver interface {
+	Resolve(host string) (string, error)
+}
+
+func SetBrowserResolver(BrowserResolver) {}
