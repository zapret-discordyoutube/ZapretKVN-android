+// applyMasking merges the app's masking block into the generated outbound, by
+// name and in Xray's own shape: "mux" on the outbound, "finalmask" on the
+// stream, "xmux" in the XHTTP settings. An XHTTP "extra" replaces the whole
+// XHTTP config inside Xray (infra/conf/transport_method.go SplitHTTPConfig.Build
+// keeps only host, path and mode), so xmux goes into "extra" when the link has
+// one; otherwise the core would silently ignore it. Unknown keys are refused:
+// the app never hands the core something it did not mean to.
+func applyMasking(outbound object, stream object, masking map[string]any) error {
+	for key, value := range masking {
+		switch key {
+		case "mux":
+			outbound["mux"] = value
+		case "finalmask":
+			stream["finalmask"] = value
+		case "xmux":
+			xhttp, ok := stream["xhttpSettings"].(object)
+			if !ok {
+				return fmt.Errorf("xray_masking.xmux needs an XHTTP transport")
+			}
+			if extra, ok := xhttp["extra"].(object); ok {
+				extra["xmux"] = value
+			} else {
+				xhttp["xmux"] = value
+			}
+		default:
+			return fmt.Errorf("unknown xray_masking key: %s", key)
+		}
+	}
+	return nil
+}
+
 func protectStream(stream object, dialerID string) {
 	// App-owned socket boundary only; protocol/TLS fields remain core-native.
 	stream["sockopt"] = object{"interface": dialerID}
diff --git a/protocol/xraycore/masking_test.go b/protocol/xraycore/masking_test.go
