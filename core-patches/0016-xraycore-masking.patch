diff --git a/protocol/xraycore/config.go b/protocol/xraycore/config.go
index 94bea8cc..54855477 100644
--- a/protocol/xraycore/config.go
+++ b/protocol/xraycore/config.go
@@ -28,10 +28,44 @@ func buildConfig(options option.VLESSOutboundOptions, dialerID string) ([]byte,
 		return nil, err
 	}
 	stream := outbound["streamSettings"].(object)
+	if err := applyMasking(outbound, stream, options.XrayMasking); err != nil {
+		return nil, err
