--- /dev/null
+++ b/protocol/xraycore/prepare.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# The only local Xray change is logger interface integration with the pinned
+# sing fork. Protocol code is copied unchanged from the verified upstream module.
+source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+module="$1"
+expected_commit="$2"
+destination="$source_root/third_party/xray-core"
+[[ ! -e "$destination" ]] || { echo "Xray source already exists: $destination" >&2; exit 1; }
+metadata="$(go mod download -json "$module")"
+[[ "$(jq -r '.Origin.Hash' <<< "$metadata")" == "$expected_commit" ]]
+[[ "$(jq -r '.Path + "@" + .Version' <<< "$metadata")" == "$module" ]]
+module_dir="$(jq -r '.Dir' <<< "$metadata")"
+[[ -f "$module_dir/go.mod" && -f "$module_dir/LICENSE" ]]
+mkdir -p "$source_root/third_party"
+temporary="$(mktemp -d "$source_root/third_party/xray-prepare.XXXXXXXX")"
+trap 'rm -rf -- "$temporary"' EXIT
+cp -a "$module_dir/." "$temporary/"
+chmod -R u+w "$temporary"
+git -C "$source_root" apply --directory="${temporary#"$source_root/"}" "$source_root/protocol/xraycore/logger.patch"
+mv "$temporary" "$destination"
