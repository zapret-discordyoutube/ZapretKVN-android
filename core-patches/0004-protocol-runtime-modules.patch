+package xraycore
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	singjson "github.com/sagernet/sing/common/json"
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf/serial"
+	"github.com/xtls/xray-core/transport/internet/grpc"
+	"github.com/xtls/xray-core/transport/internet/httpupgrade"
+	"github.com/xtls/xray-core/transport/internet/splithttp"
+	"github.com/xtls/xray-core/transport/internet/websocket"
+)
+
+// legacyOptions parses a raw sing-box VLESS outbound exactly as a saved profile
+// without the original link reaches the adapter.
+func legacyOptions(t *testing.T, text string) option.VLESSOutboundOptions {
+	t.Helper()
+	var options option.VLESSOutboundOptions
+	if err := singjson.UnmarshalContext(context.Background(), []byte(text), &options); err != nil {
+		t.Fatal(err)
+	}
+	return options
+}
+
+// xrayStream runs the generated document through the same Xray parser and
+// builder as NewOutbound and returns the typed transport settings.
+func xrayStream(t *testing.T, options option.VLESSOutboundOptions) (map[string]any, *core.Config, *proxyman.SenderConfig) {
+	t.Helper()
+	data, err := buildConfig(options, "test-dialer")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var document struct {
+		Outbounds []struct {
+			StreamSettings map[string]any `json:"streamSettings"`
+		} `json:"outbounds"`
+	}
+	if err = json.Unmarshal(data, &document); err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := serial.DecodeJSONConfig(bytes.NewReader(data))
+	if err != nil {
+		t.Fatalf("Xray rejected the generated config: %v\n%s", err, data)
+	}
+	config, err := parsed.Build()
+	if err != nil {
+		t.Fatalf("Xray could not build the generated config: %v\n%s", err, data)
+	}
+	instance, err := config.Outbound[0].SenderSettings.GetInstance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sender, ok := instance.(*proxyman.SenderConfig)
+	if !ok {
+		t.Fatalf("unexpected sender settings %T", instance)
+	}
+	return document.Outbounds[0].StreamSettings, config, sender
+}
+
+func transportSettings(t *testing.T, sender *proxyman.SenderConfig, protocol string) any {
+	t.Helper()
+	for _, settings := range sender.StreamSettings.TransportSettings {
+		if settings.ProtocolName == protocol {
+			instance, err := settings.Settings.GetInstance()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return instance
+		}
+	}
+	t.Fatalf("no %s transport in the Xray config", protocol)
+	return nil
+}
+
+const legacyVLESS = `{"type":"vless","server":"example.net","server_port":443,"uuid":"b831381d-6324-4d53-ad4f-8cda48b30811",`
+
+func TestLegacyWebSocketHeadersUseXrayShape(t *testing.T) {
+	options := legacyOptions(t, legacyVLESS+`
+		"tls":{"enabled":true,"server_name":"front.example.net","alpn":["h2","http/1.1"],"utls":{"enabled":true,"fingerprint":"chrome"}},
+		"transport":{"type":"ws","path":"/ws","headers":{"Host":"cdn.example.com","User-Agent":"UA/1","X-Multi":["a","b"]}}}`)
+	stream, _, sender := xrayStream(t, options)
+	settings := stream["wsSettings"].(map[string]any)
+	if settings["host"] != "cdn.example.com" {
+		t.Fatalf("Host header did not become the Xray host: %v", settings)
+	}
+	want := map[string]any{"User-Agent": "UA/1", "X-Multi": "a, b"}
+	if !reflect.DeepEqual(settings["headers"], want) {
+		t.Fatalf("headers = %v, want %v", settings["headers"], want)
+	}
+	ws := transportSettings(t, sender, "websocket").(*websocket.Config)
+	if ws.Host != "cdn.example.com" || ws.Path != "/ws" {
+		t.Fatalf("Xray websocket host/path: %q %q", ws.Host, ws.Path)
+	}
+	if !reflect.DeepEqual(ws.Header, map[string]string{"User-Agent": "UA/1", "X-Multi": "a, b"}) {
+		t.Fatalf("Xray websocket headers: %v", ws.Header)
+	}
+}
+
+func TestLegacyWebSocketHostOnlyAndNoHeaders(t *testing.T) {
+	stream, _, sender := xrayStream(t, legacyOptions(t, legacyVLESS+`"transport":{"type":"ws","path":"/","headers":{"host":"cdn.example.com"}}}`))
+	settings := stream["wsSettings"].(map[string]any)
+	if _, present := settings["headers"]; present || settings["host"] != "cdn.example.com" {
+		t.Fatalf("host-only headers: %v", settings)
+	}
+	if ws := transportSettings(t, sender, "websocket").(*websocket.Config); ws.Host != "cdn.example.com" || len(ws.Header) != 0 {
+		t.Fatalf("Xray websocket: %q %v", ws.Host, ws.Header)
+	}
+	stream, _, _ = xrayStream(t, legacyOptions(t, legacyVLESS+`"transport":{"type":"ws","path":"/ws"}}`))
+	settings = stream["wsSettings"].(map[string]any)
+	if _, present := settings["headers"]; present {
+		t.Fatalf("empty headers must be omitted: %v", settings)
+	}
+	if _, present := settings["host"]; present {
+		t.Fatalf("empty host must be omitted: %v", settings)
+	}
+}
+
+func TestLegacyHTTPUpgradeHostAndHeadersUseXrayShape(t *testing.T) {
+	options := legacyOptions(t, legacyVLESS+`
+		"transport":{"type":"httpupgrade","host":"cdn.example.com","path":"/up","headers":{"Host":"ignored.example.com","X-Multi":["a","b"],"User-Agent":"UA/1"}}}`)
+	stream, _, sender := xrayStream(t, options)
+	settings := stream["httpupgradeSettings"].(map[string]any)
+	if settings["host"] != "cdn.example.com" {
+		t.Fatalf("the Host field must win over a Host header: %v", settings)
+	}
+	hu := transportSettings(t, sender, "httpupgrade").(*httpupgrade.Config)
+	if hu.Host != "cdn.example.com" || hu.Path != "/up" {
+		t.Fatalf("Xray httpupgrade host/path: %q %q", hu.Host, hu.Path)
+	}
+	if !reflect.DeepEqual(hu.Header, map[string]string{"User-Agent": "UA/1", "X-Multi": "a, b"}) {
+		t.Fatalf("Xray httpupgrade headers: %v", hu.Header)
+	}
+
+	// Without the Host field, Xray (which rejects Host in headers) gets the header value as host.
+	stream, _, sender = xrayStream(t, legacyOptions(t, legacyVLESS+`"transport":{"type":"httpupgrade","path":"/up","headers":{"Host":"cdn2.example.com"}}}`))
+	if stream["httpupgradeSettings"].(map[string]any)["host"] != "cdn2.example.com" {
+		t.Fatalf("Host header fallback: %v", stream["httpupgradeSettings"])
+	}
+	if hu = transportSettings(t, sender, "httpupgrade").(*httpupgrade.Config); hu.Host != "cdn2.example.com" || len(hu.Header) != 0 {
+		t.Fatalf("Xray httpupgrade: %q %v", hu.Host, hu.Header)
+	}
+}
+
+func TestLegacyGRPCAndXHTTPAreAcceptedByXray(t *testing.T) {
+	_, _, sender := xrayStream(t, legacyOptions(t, legacyVLESS+`"transport":{"type":"grpc","service_name":"svc"}}`))
+	if g := transportSettings(t, sender, "grpc").(*grpc.Config); g.ServiceName != "svc" {
+		t.Fatalf("Xray grpc service: %q", g.ServiceName)
+	}
+	_, _, sender = xrayStream(t, legacyOptions(t, legacyVLESS+`
+		"transport":{"type":"xhttp","host":"cdn.example.com","path":"/x","headers":{"X-Foo":"bar"},"x_padding_bytes":"100-1000"}}`))
+	sh := transportSettings(t, sender, "splithttp").(*splithttp.Config)
+	if sh.Host != "cdn.example.com" || sh.Path != "/x" || sh.Headers["X-Foo"] != "bar" {
+		t.Fatalf("Xray xhttp: %q %q %v", sh.Host, sh.Path, sh.Headers)
+	}
+}
+
+// Imports keep the original link, which is already Xray-native: its output
+// must not change with the legacy header conversion.
+func TestURITransportsKeepTheirShape(t *testing.T) {
+	const id = "b831381d-6324-4d53-ad4f-8cda48b30811"
+	cases := map[string]struct {
+		key  string
+		want map[string]any
+	}{
+		"ws":          {"wsSettings", map[string]any{"path": "/ws", "headers": map[string]any{"Host": "cdn.example.com"}}},
+		"httpupgrade": {"httpupgradeSettings", map[string]any{"path": "/ws", "host": "cdn.example.com"}},
+	}
+	for network, want := range cases {
+		options := option.VLESSOutboundOptions{URI: "vless://" + id + "@example.net:443?type=" + network + "&security=none&path=/ws&host=cdn.example.com"}
+		stream, _, _ := xrayStream(t, options)
+		if !reflect.DeepEqual(stream[want.key], want.want) {
+			t.Fatalf("%s URI settings = %v, want %v", network, stream[want.key], want.want)
+		}
+	}
+	_, _, sender := xrayStream(t, option.VLESSOutboundOptions{URI: "vless://" + id + "@example.net:443?type=ws&security=none&path=/ws&host=cdn.example.com"})
+	if ws := transportSettings(t, sender, "websocket").(*websocket.Config); ws.Host != "cdn.example.com" {
+		t.Fatalf("Xray websocket host from URI: %q", ws.Host)
+	}
+}
