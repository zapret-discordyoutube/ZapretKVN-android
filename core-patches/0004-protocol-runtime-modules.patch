+func TestNormalizeCloseErrorTreatsBenignTeardownAsClosed(t *testing.T) {
+	closed := []error{
+		&quic.StreamError{StreamID: 4, ErrorCode: 0, Remote: false},
+		&quic.StreamError{StreamID: 4, ErrorCode: 0, Remote: true},
+		E.Cause(&quic.StreamError{StreamID: 4, ErrorCode: 0}, "read response"),
+		&quic.ApplicationError{ErrorCode: 0, Remote: true},
+		&quic.ApplicationError{ErrorCode: connectionCloseOK, Remote: true},
+		&quic.ApplicationError{ErrorCode: connectionCloseOK, Remote: false},
+		&quic.ApplicationError{ErrorCode: 0x101, Remote: false},
+	}
+	for _, err := range closed {
+		got := normalizeCloseError(err)
+		if !errors.Is(got, net.ErrClosed) || !E.IsClosedOrCanceled(got) {
+			t.Errorf("%v was not mapped to a closed error: %v", err, got)
+		}
+		var original *quic.StreamError
+		var application *quic.ApplicationError
+		if !errors.As(got, &original) && !errors.As(got, &application) {
+			t.Errorf("%v lost its original cause: %v", err, got)
+		}
+	}
+	kept := []error{
+		nil,
+		io.EOF,
+		&quic.StreamError{StreamID: 4, ErrorCode: 1, Remote: true},
+		&quic.ApplicationError{ErrorCode: 0x101, Remote: true},
+		coreErrs.DialError{Message: "refused"},
+	}
+	for _, err := range kept {
+		if got := normalizeCloseError(err); got != err {
+			t.Errorf("%v must pass through unchanged, got %v", err, got)
+		}
+	}
+}
