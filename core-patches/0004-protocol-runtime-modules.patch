+type blockingClient struct {
+	stubClient
+	started chan struct{}
+	release chan struct{}
+	conn    *probeConn
+	calls   atomic.Int32
+}
+
+func (c *blockingClient) TCP(string) (net.Conn, error) {
+	c.calls.Add(1)
+	close(c.started)
+	<-c.release
+	return c.conn, nil
+}
+
+func TestDialTCPCancellationReturnsImmediatelyAndClosesLateConnection(t *testing.T) {
+	client := &blockingClient{started: make(chan struct{}), release: make(chan struct{}), conn: &probeConn{}}
+	ctx, cancel := context.WithCancel(context.Background())
+	type outcome struct {
+		conn net.Conn
+		err  error
+	}
+	result := make(chan outcome, 1)
+	go func() {
+		conn, err := dialTCP(ctx, client, "example.com:443")
+		result <- outcome{conn, err}
+	}()
+	<-client.started
+	cancel()
+	select {
+	case got := <-result:
+		if got.conn != nil || !errors.Is(got.err, context.Canceled) {
+			t.Fatalf("canceled dial returned conn=%v err=%v", got.conn, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("dialTCP did not return while the handshake was stalled")
+	}
+	if client.conn.closed.Load() {
+		t.Fatal("connection closed before the stalled handshake finished")
+	}
+	close(client.release)
+	deadline := time.Now().Add(2 * time.Second)
+	for !client.conn.closed.Load() && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if !client.conn.closed.Load() {
+		t.Fatal("connection established after cancellation leaked")
+	}
+}
+
+func TestDialTCPDoesNotStartWithCanceledContext(t *testing.T) {
+	client := &blockingClient{started: make(chan struct{}), release: make(chan struct{}), conn: &probeConn{}}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := dialTCP(ctx, client, "example.com:443"); !errors.Is(err, context.Canceled) {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if client.calls.Load() != 0 {
+		t.Fatal("dial started although the context was already canceled")
+	}
+}
