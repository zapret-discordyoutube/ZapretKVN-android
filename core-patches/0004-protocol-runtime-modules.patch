+	"github.com/sagernet/sing-box/common/dialer"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+	xlog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf/serial"
+	"github.com/xtls/xray-core/transport/internet"
+
+	_ "github.com/xtls/xray-core/app/dispatcher"
+	_ "github.com/xtls/xray-core/app/policy"
+	_ "github.com/xtls/xray-core/app/proxyman/inbound"
+	_ "github.com/xtls/xray-core/app/proxyman/outbound"
+	_ "github.com/xtls/xray-core/proxy/vless/outbound"
+	_ "github.com/xtls/xray-core/transport/internet/grpc"
+	_ "github.com/xtls/xray-core/transport/internet/headers/http"
+	_ "github.com/xtls/xray-core/transport/internet/headers/noop"
+	_ "github.com/xtls/xray-core/transport/internet/httpupgrade"
+	_ "github.com/xtls/xray-core/transport/internet/kcp"
+	_ "github.com/xtls/xray-core/transport/internet/reality"
+	_ "github.com/xtls/xray-core/transport/internet/splithttp"
+	_ "github.com/xtls/xray-core/transport/internet/tcp"
+	_ "github.com/xtls/xray-core/transport/internet/tls"
+	_ "github.com/xtls/xray-core/transport/internet/udp"
+	_ "github.com/xtls/xray-core/transport/internet/websocket"
+)
+
+var protectedDialers sync.Map
+var nextDialerID atomic.Uint64
+var logFactories = struct {
+	sync.Mutex
+	refs map[log.Factory]int
+}{refs: make(map[log.Factory]int)}
+
+func init() {
+	// Install once. Never swap the global dialer during a connection/transition.
+	internet.UseAlternativeSystemDialer(protectedSystemDialer{})
+	xlog.RegisterHandler(coreLogHandler{})
+}
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[option.VLESSOutboundOptions](registry, C.TypeVLESS, NewOutbound)
+}
+
+type Outbound struct {
+	outbound.Adapter
+	instance  *core.Instance
+	logger    log.ContextLogger
+	factory   log.Factory
+	dialerID  string
+	ctx       context.Context
+	cancel    context.CancelFunc
+	closeOnce sync.Once
+	closed    atomic.Bool
+}
+
+func NewOutbound(ctx context.Context, _ adapter.Router, logger log.ContextLogger, tag string, options option.VLESSOutboundOptions) (adapter.Outbound, error) {
+	protected, err := dialer.New(ctx, options.DialerOptions, true)
+	if err != nil {
+		return nil, err
+	}
+	id := fmt.Sprintf("zapret-xray-%d", nextDialerID.Add(1))
+	configBytes, err := buildConfig(options, id)
+	if err != nil {
+		return nil, err
+	}
+	document, err := serial.DecodeJSONConfig(bytes.NewReader(configBytes))
+	if err != nil {
+		return nil, err
+	}
+	config, err := document.Build()
+	if err != nil {
+		return nil, err
+	}
+	// Xray's process-global console logger must not replace the app observer.
+	apps := config.App[:0]
+	for _, app := range config.App {
+		if app.Type != "xray.app.log.Config" {
+			apps = append(apps, app)
+		}
+	}
+	config.App = apps
+	factory := service.FromContext[log.Factory](ctx)
+	if factory != nil {
+		logFactories.Lock()
+		logFactories.refs[factory]++
+		logFactories.Unlock()
+	}
+	ownedContext, cancel := context.WithCancel(ctx)
+	protectedDialers.Store(id, ownedDialer{dialer: protected, ctx: ownedContext})
+	instance, err := core.NewWithContext(ownedContext, config)
+	if err != nil {
+		cancel()
+		protectedDialers.Delete(id)
+		releaseLogger(factory)
+		return nil, err
+	}
+	return &Outbound{
+		Adapter:  outbound.NewAdapterWithDialerOptions(C.TypeVLESS, tag, options.Network.Build(), options.DialerOptions),
+		instance: instance, logger: logger, factory: factory, dialerID: id, ctx: ownedContext, cancel: cancel,
+	}, nil
+}
+
+func (h *Outbound) Start(stage adapter.StartStage) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	if h.closed.Load() {
+		return os.ErrClosed
+	}
+	return h.instance.Start()
+}
+
+func (h *Outbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if h.closed.Load() {
+		return nil, os.ErrClosed
+	}
+	dest, err := xnet.ParseDestination(network + ":" + destination.String())
+	if err != nil {
+		return nil, err
+	}
+	linkCtx, release := h.linkContext(ctx)
+	conn, err := core.Dial(linkCtx, h.instance, dest)
+	if err != nil {
+		release()
+		h.logger.ErrorContext(ctx, err)
+		return nil, err
+	}
+	context.AfterFunc(linkCtx, func() { _ = conn.Close() })
+	return &linkConn{Conn: conn, release: release}, nil
+}
+
+func (h *Outbound) ListenPacket(ctx context.Context, _ M.Socksaddr) (net.PacketConn, error) {
+	if h.closed.Load() {
+		return nil, os.ErrClosed
+	}
+	linkCtx, release := h.linkContext(ctx)
+	conn, err := core.DialUDP(linkCtx, h.instance)
+	if err != nil {
+		release()
+		h.logger.ErrorContext(ctx, err)
+		return nil, err
+	}
+	context.AfterFunc(linkCtx, func() { _ = conn.Close() })
+	return &linkPacketConn{PacketConn: conn, release: release}, nil
+}
+
+// linkContext detaches an Xray link from the caller's dial context. sing-box
+// callers (the 1.14 DNS connection pools) cancel that context as soon as dial
+// returns and keep the connection, while Xray dispatches the upstream dial
+// asynchronously and binds the whole link to the context it was given.
+// Values (log IDs, inbound metadata) are kept; the link ends when the
+// connection is closed or the owning outbound shuts down.
+func (h *Outbound) linkContext(ctx context.Context) (context.Context, context.CancelFunc) {
+	linkCtx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	stop := context.AfterFunc(h.ctx, cancel)
+	return linkCtx, func() {
+		stop()
+		cancel()
+	}
+}
+
+func (h *Outbound) Close() error {
+	var err error
+	h.closeOnce.Do(func() {
+		h.closed.Store(true)
+		h.cancel()
+		protectedDialers.Delete(h.dialerID)
+		err = h.instance.Close()
+		releaseLogger(h.factory)
+	})
+	return err
+}
+
+type protectedSystemDialer struct{}
+
+type ownedDialer struct {
+	dialer N.Dialer
+	ctx    context.Context
+}
+
+type ownedConn struct {
+	net.Conn
+	stop func() bool
+}
+
+type ownedPacketConn struct {
+	net.PacketConn
+	stop func() bool
+}
+
+type linkConn struct {
+	net.Conn
+	release context.CancelFunc
+}
+
+type linkPacketConn struct {
+	net.PacketConn
+	release context.CancelFunc
+}
+
+func (c *linkConn) Close() error {
+	err := c.Conn.Close()
+	c.release()
+	return err
+}
+
+func (c *linkPacketConn) Close() error {
+	err := c.PacketConn.Close()
+	c.release()
+	return err
+}
+
+func (c *ownedPacketConn) Close() error {
+	c.stop()
+	return c.PacketConn.Close()
+}
+
+func (c *ownedConn) Close() error {
+	c.stop()
+	return c.Conn.Close()
+}
+
+func (protectedSystemDialer) Dial(ctx context.Context, _ xnet.Address, destination xnet.Destination, socket *internet.SocketConfig) (net.Conn, error) {
+	if socket == nil {
+		return nil, fmt.Errorf("Xray socket has no protected dialer identity")
+	}
+	value, ok := protectedDialers.Load(socket.Interface)
+	if !ok {
+		return nil, fmt.Errorf("Xray protected dialer is closed or missing")
+	}
+	// Includes XHTTP alternate endpoints and all UDP sockets: even a cancelled
+	// or stale Xray callback can never fall back to an unprotected system socket.
+	owner := value.(ownedDialer)
+	if err := owner.ctx.Err(); err != nil {
+		return nil, err
+	}
+	dialContext, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(owner.ctx, cancel)
+	defer stop()
+	defer cancel()
+	target := M.ParseSocksaddr(destination.NetAddr())
+	if destination.Network == xnet.Network_UDP {
+		var conn net.PacketConn
+		var err error
+		if resolver, ok := owner.dialer.(interface {
+			ListenPacketWithDestination(context.Context, M.Socksaddr) (net.PacketConn, netip.Addr, error)
+		}); ok {
+			var address netip.Addr
+			conn, address, err = resolver.ListenPacketWithDestination(dialContext, target)
+			target = M.SocksaddrFrom(address, target.Port)
+		} else if target.IsDomain() {
+			return nil, fmt.Errorf("Xray UDP transport requires a protected domain resolver")
+		} else {
+			conn, err = owner.dialer.ListenPacket(dialContext, target)
+		}
+		if err != nil {
+			return nil, err
+		}
+		owned := &ownedPacketConn{PacketConn: conn, stop: context.AfterFunc(owner.ctx, func() { _ = conn.Close() })}
+		return &internet.PacketConnWrapper{PacketConn: owned, Dest: target.UDPAddr()}, nil
+	}
+	conn, err := owner.dialer.DialContext(dialContext, destination.Network.SystemString(), target)
+	if err != nil {
+		return nil, err
+	}
+	return &ownedConn{Conn: conn, stop: context.AfterFunc(owner.ctx, func() { _ = conn.Close() })}, nil
+}
+func (protectedSystemDialer) DestIpAddress() net.IP { return nil }
+
+func releaseLogger(factory log.Factory) {
+	if factory == nil {
+		return
+	}
+	logFactories.Lock()
+	defer logFactories.Unlock()
+	logFactories.refs[factory]--
+	if logFactories.refs[factory] <= 0 {
+		delete(logFactories.refs, factory)
+	}
+}
+
+// Global Xray messages have no trustworthy target identity. Preserve them as
+// component evidence; never attach them to whichever selector target is current.
+type coreLogHandler struct{}
+
+func (coreLogHandler) Handle(message xlog.Message) {
+	general, ok := message.(*xlog.GeneralMessage)
+	if !ok || general.Severity > xlog.Severity_Warning {
+		return
+	}
+	logFactories.Lock()
+	factories := make([]log.Factory, 0, len(logFactories.refs))
+	for factory := range logFactories.refs {
+		factories = append(factories, factory)
+	}
+	logFactories.Unlock()
+	for _, factory := range factories {
+		logger := factory.NewLogger("xray")
+		if general.Severity <= xlog.Severity_Error {
+			logger.Error(message.String())
+		} else {
+			logger.Warn(message.String())
+		}
+	}
+}
