@@ -0,0 +1,66 @@
+package hysteria2
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+// Exercise the production resolveDialer, substituting only DNS and the socket.
+type loopbackDNS struct{ adapter.DNSRouter }
+
+func (loopbackDNS) Lookup(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+}
+
+func resolvedLoopbackDialer() N.Dialer {
+	ctx := service.ContextWith[adapter.DNSRouter](context.Background(), loopbackDNS{})
+	return dialer.NewResolveDialer(ctx, realPacketDialer{}, false, "", adapter.DNSQueryOptions{}, 0)
+}
+
+func TestAuditDomainPacketAddress(t *testing.T) {
+	remote, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer remote.Close()
+	factory, expected, err := newProtectedConnFactory(context.Background(), resolvedLoopbackDialer(), option.Hysteria2OutboundOptions{
+		ServerOptions: option.ServerOptions{Server: "synthetic.example", ServerPort: uint16(remote.LocalAddr().(*net.UDPAddr).Port)},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := factory.New(expected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(time.Second))
+	_ = remote.SetDeadline(time.Now().Add(time.Second))
+	if _, err = conn.WriteTo([]byte("query"), expected); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 64)
+	_, sender, err := remote.ReadFrom(buffer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = remote.WriteTo([]byte("response"), sender); err != nil {
+		t.Fatal(err)
+	}
+	_, actual, err := conn.ReadFrom(buffer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if actual.String() != expected.String() {
+		t.Fatalf("QUIC peer identity lost at protected dialer boundary: expected=%s actual=%s", expected, actual)
+	}
+}
