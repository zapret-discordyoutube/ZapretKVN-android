+// startFastOpenOutbound runs an upstream Hysteria2 server with a scripted target
+// dialer and returns the production Outbound connected to it.
+func startFastOpenOutbound(t *testing.T, target func(string) (net.Conn, error)) *Outbound {
+	t.Helper()
+	serverSocket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := hyserver.NewServer(&hyserver.Config{
+		TLSConfig:     hyserver.TLSConfig{Certificates: []tls.Certificate{syntheticCertificate(t)}},
+		Conn:          serverSocket,
+		Authenticator: allowSyntheticAuth{},
+		Outbound:      scriptedServerOutbound{tcp: target},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = server.Close() })
+	go func() { _ = server.Serve() }()
+	ctx, cancel := context.WithCancel(context.Background())
+	outbound := &Outbound{
+		ctx:    ctx,
+		cancel: cancel,
+		logger: log.NewNOPFactory().Logger(),
+		dialer: realPacketDialer{},
+		options: option.Hysteria2OutboundOptions{
+			ServerOptions:               option.ServerOptions{Server: "127.0.0.1", ServerPort: uint16(serverSocket.LocalAddr().(*net.UDPAddr).Port)},
+			Password:                    "synthetic-auth",
+			OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{Enabled: true, Insecure: true}},
+		},
+	}
+	client, err := outbound.newClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	outbound.client = client
+	t.Cleanup(func() { _ = outbound.Close() })
+	return outbound
+}
+
+func TestFastOpenDoesNotWaitForServerDial(t *testing.T) {
+	echo, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		conn, acceptErr := echo.Accept()
+		if acceptErr == nil {
+			_, _ = io.Copy(conn, conn)
+			_ = conn.Close()
+		}
+	}()
+	release := make(chan struct{})
+	outbound := startFastOpenOutbound(t, func(address string) (net.Conn, error) {
+		<-release
+		return net.Dial("tcp4", echo.Addr().String())
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	// The server is still "dialing" the target; without FastOpen this call blocks.
+	conn, err := outbound.DialContext(ctx, "tcp", M.ParseSocksaddr("203.0.113.7:443"))
+	if err != nil {
+		t.Fatalf("dial must not wait for the server-side target dial: %v", err)
+	}
+	defer conn.Close()
+	payload := []byte("early data before the server response")
+	if _, err = conn.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	close(release)
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	received := make([]byte, len(payload))
+	if _, err = io.ReadFull(conn, received); err != nil || string(received) != string(payload) {
+		t.Fatalf("early write was not delivered: %q %v", received, err)
+	}
+}
+
+func TestFastOpenServerRefusalSurfacesFromRead(t *testing.T) {
+	outbound := startFastOpenOutbound(t, func(string) (net.Conn, error) {
+		return nil, errors.New("synthetic refusal")
+	})
+	conn, err := outbound.DialContext(context.Background(), "tcp", M.ParseSocksaddr("203.0.113.7:443"))
+	if err != nil {
+		t.Fatalf("FastOpen dial reports success before the server answers: %v", err)
+	}
+	defer conn.Close()
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	_, err = conn.Read(make([]byte, 16))
+	var dialError coreErrs.DialError
+	if !errors.As(err, &dialError) || dialError.Message == "" {
+		t.Fatalf("server refusal did not surface as DialError from Read: %v", err)
+	}
+	if E.IsClosedOrCanceled(err) {
+		t.Fatalf("refusal must stay a real error, got %v", err)
+	}
+}
+
+func TestLocalCloseDuringReadIsReportedAsClosed(t *testing.T) {
+	serverSide, targetSide := net.Pipe()
+	defer targetSide.Close()
+	outbound := startFastOpenOutbound(t, func(string) (net.Conn, error) { return serverSide, nil })
+	conn, err := outbound.DialContext(context.Background(), "tcp", M.ParseSocksaddr("203.0.113.7:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	readResult := make(chan error, 1)
+	go func() {
+		_, readErr := conn.Read(make([]byte, 16))
+		readResult <- readErr
+	}()
+	time.Sleep(200 * time.Millisecond)
+	_ = conn.Close()
+	select {
+	case err = <-readResult:
+	case <-time.After(5 * time.Second):
+		t.Fatal("blocked Read was not released by Close")
+	}
+	var streamError *quic.StreamError
+	if !errors.As(err, &streamError) {
+		t.Fatalf("expected the original quic stream cancellation to stay reachable, got %v", err)
+	}
+	if !errors.Is(err, net.ErrClosed) || !E.IsClosedOrCanceled(err) {
+		t.Fatalf("local stream cancellation must look like a normal close to sing-box: %v", err)
+	}
+}
