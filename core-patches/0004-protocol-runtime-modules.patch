 func (d *resolveDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
-	conn, _, err := d.ListenPacketWithDestination(ctx, destination)
-	return conn, err
+	conn, address, err := d.ListenPacketWithDestination(ctx, destination)
+	if err != nil || !destination.IsDomain() {
+		return conn, err
+	}
+	return bufio.NewNATPacketConn(bufio.NewPacketConn(conn), M.SocksaddrFrom(address, destination.Port), destination), nil
 }
 
 // ListenPacketWithDestination opens the same protected/bound socket as
@@ -139,7 +142,8 @@ func (d *resolveDialer) ListenPacketWithDestination(ctx context.Context, destina
 	if err != nil {
 		return nil, netip.Addr{}, err
 	}
-	return bufio.NewNATPacketConn(bufio.NewPacketConn(conn), M.SocksaddrFrom(destinationAddress, destination.Port), destination), destinationAddress, nil
+	// Native QUIC needs the actual peer address, not the ordinary domain NAT view.
+	return conn, destinationAddress, nil
 }
 
