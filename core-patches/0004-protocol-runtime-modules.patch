+// Package xraycore delegates VLESS and its transports to the official Xray core.
+// sing-box owns routing and all underlying socket creation. No second TUN or
+// localhost proxy is needed inside Android.
+package xraycore
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
