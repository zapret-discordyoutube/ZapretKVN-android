-
-func parseClientEncryption(raw string) (clientEncryptionConfig, error) {
-	var cfg clientEncryptionConfig
-	raw = strings.TrimSpace(raw)
-	if raw == "" {
-		return cfg, E.New("empty encryption string")
-	}
-	parts := strings.Split(raw, ".")
-	if len(parts) < 4 {
-		return cfg, E.New("invalid encryption string: missing components")
-	}
-	if parts[0] != "mlkem768x25519plus" {
-		return cfg, E.New("unsupported encryption prefix: ", parts[0])
-	}
-	switch parts[1] {
-	case "native":
-		cfg.xorMode = 0
-	case "xorpub":
-		cfg.xorMode = 1
-	case "random":
-		cfg.xorMode = 2
-	default:
-		return cfg, E.New("unknown encryption mode: ", parts[1])
-	}
-	switch parts[2] {
-	case "0rtt":
-		cfg.seconds = 1
-	case "1rtt":
-		cfg.seconds = 0
-	default:
-		return cfg, E.New("unsupported encryption RTT value: ", parts[2])
-	}
-	paddingPhase := true
-	var paddingParts []string
-	for _, segment := range parts[3:] {
-		segment = strings.TrimSpace(segment)
-		if segment == "" {
-			return cfg, E.New("invalid empty segment in encryption string")
-		}
-		if data, err := base64.RawURLEncoding.DecodeString(segment); err == nil {
-			if len(data) == 32 || len(data) == 1184 {
-				cfg.keys = append(cfg.keys, data)
-				paddingPhase = false
-				continue
-			}
-			return cfg, E.New("invalid encryption key length: ", len(data))
-		}
-		if paddingPhase {
-			paddingParts = append(paddingParts, segment)
-			continue
-		}
-		return cfg, E.New("invalid encryption key: ", segment)
-	}
-	if len(cfg.keys) == 0 {
-		return cfg, E.New("no valid encryption keys found in encryption string")
-	}
-	if len(paddingParts) > 0 {
-		cfg.padding = strings.Join(paddingParts, ".")
-	}
-	return cfg, nil
-}
diff --git a/protocol/xraycore/config.go b/protocol/xraycore/config.go
new file mode 100644
index 00000000..7972cd44
--- /dev/null
+++ b/protocol/xraycore/config.go
@@ -0,0 +1,249 @@
+package xraycore
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+type object = map[string]any
+
+func buildConfig(options option.VLESSOutboundOptions, dialerID string) ([]byte, error) {
+	var outbound object
+	var err error
+	if options.URI != "" {
+		outbound, err = outboundFromURI(options.URI)
+	} else {
+		outbound, err = legacyOutbound(options)
+	}
+	if err != nil {
+		return nil, err
+	}
+	stream := outbound["streamSettings"].(object)
+	protectStream(stream, dialerID)
+	return json.Marshal(object{"outbounds": []any{outbound}})
+}
+
+func protectStream(stream object, dialerID string) {
+	// App-owned socket boundary only; protocol/TLS fields remain core-native.
+	stream["sockopt"] = object{"interface": dialerID}
+	if xhttp, ok := stream["xhttpSettings"].(object); ok {
+		if extra, ok := xhttp["extra"].(object); ok {
+			if download, ok := extra["downloadSettings"].(object); ok {
+				protectStream(download, dialerID)
+			}
+		}
+		if download, ok := xhttp["downloadSettings"].(object); ok {
+			protectStream(download, dialerID)
+		}
+	}
+}
+
+func vlessOutbound(server string, port int, user object, stream object) object {
+	return object{
+		"tag": "proxy", "protocol": "vless",
+		"settings":       object{"vnext": []any{object{"address": server, "port": port, "users": []any{user}}}},
+		"streamSettings": stream,
+	}
+}
+
+func outboundFromURI(raw string) (object, error) {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return nil, fmt.Errorf("invalid VLESS URI syntax")
+	}
+	if !strings.EqualFold(u.Scheme, "vless") || u.User == nil || u.User.Username() == "" || u.Hostname() == "" {
+		return nil, fmt.Errorf("VLESS URI requires a user and server")
+	}
+	q, err := url.ParseQuery(u.RawQuery)
+	if err != nil {
+		return nil, fmt.Errorf("invalid VLESS URI query")
+	}
+	for key, values := range q {
+		if len(values) != 1 {
+			return nil, fmt.Errorf("duplicate VLESS query parameter: %s", key)
+		}
+	}
+	value := func(key, fallback string) string {
+		if q.Has(key) {
+			return q.Get(key)
+		}
+		return fallback
+	}
+	port := 443
+	if u.Port() != "" {
+		port, err = strconv.Atoi(u.Port())
+		if err != nil || port < 1 || port > 65535 {
+			return nil, fmt.Errorf("invalid VLESS server port")
+		}
+	}
+	user := object{"id": u.User.Username(), "encryption": value("encryption", "none")}
+	if q.Has("flow") {
+		user["flow"] = q.Get("flow")
+	}
+	network := value("type", "tcp")
+	security := value("security", "none")
+	stream := object{"network": network, "security": security}
+	if security == "tls" || security == "reality" {
+		tls := object{"serverName": value("sni", u.Hostname()), "fingerprint": value("fp", "chrome")}
+		if q.Has("alpn") {
+			tls["alpn"] = strings.Split(q.Get("alpn"), ",")
+		}
+		if security == "reality" {
+			for from, to := range map[string]string{"pbk": "publicKey", "sid": "shortId", "spx": "spiderX", "pqv": "mldsa65Verify"} {
+				if q.Has(from) {
+					tls[to] = q.Get(from)
+				}
+			}
+		} else {
+			for _, key := range []string{"allowInsecure", "insecure"} {
+				if q.Has(key) {
+					insecure, parseErr := strconv.ParseBool(q.Get(key))
+					if parseErr != nil {
+						return nil, fmt.Errorf("invalid VLESS TLS boolean: %s", key)
+					}
+					tls["allowInsecure"] = insecure
+				}
+			}
+		}
+		stream[security+"Settings"] = tls
+	}
+	transport := object{}
+	switch network {
+	case "tcp", "raw":
+		if q.Get("headerType") != "" && q.Get("headerType") != "none" {
+			transport["header"] = object{"type": q.Get("headerType"), "request": object{
+				"path": []string{value("path", "/")}, "headers": object{"Host": strings.Split(value("host", u.Hostname()), ",")},
+			}}
+		}
+	case "ws", "httpupgrade":
+		transport["path"] = value("path", "/")
+		if network == "ws" {
+			transport["headers"] = object{"Host": q.Get("host")}
+		} else {
+			transport["host"] = q.Get("host")
+		}
+	case "grpc":
+		transport["serviceName"] = q.Get("serviceName")
+		if q.Get("mode") == "multi" {
+			transport["multiMode"] = true
+		}
+		if q.Has("authority") {
+			transport["authority"] = q.Get("authority")
+		}
+	case "xhttp", "splithttp":
+		transport["host"] = q.Get("host")
+		transport["path"] = value("path", "/")
+		transport["mode"] = value("mode", "auto")
+		if q.Has("extra") {
+			extraBytes := []byte(q.Get("extra"))
+			if !json.Valid(extraBytes) {
+				for _, decoder := range []*base64.Encoding{base64.RawURLEncoding, base64.URLEncoding, base64.RawStdEncoding, base64.StdEncoding} {
+					if decoded, decodeErr := decoder.DecodeString(q.Get("extra")); decodeErr == nil {
+						extraBytes = decoded
+						break
+					}
+				}
+			}
+			var extra object
+			if json.Unmarshal(extraBytes, &extra) != nil || extra == nil {
+				return nil, fmt.Errorf("invalid VLESS XHTTP extra JSON")
+			}
+			transport["extra"] = extra
+		}
+	case "kcp":
+		transport["seed"] = q.Get("seed")
+		transport["header"] = object{"type": value("headerType", "none")}
+	default:
+		return nil, fmt.Errorf("unsupported VLESS URI transport: %s", network)
+	}
+	key := network
+	if key == "raw" {
+		key = "tcp"
+	}
+	if key == "splithttp" {
+		key = "xhttp"
+	}
+	stream[key+"Settings"] = transport
+	return vlessOutbound(u.Hostname(), port, user, stream), nil
+}
+
+// Existing saved JSON is migrated at the adapter boundary. New imports retain
+// the original URI and never take this compatibility path.
+func legacyOutbound(o option.VLESSOutboundOptions) (object, error) {
+	user := object{"id": o.UUID, "encryption": o.Encryption, "flow": o.Flow}
+	if o.Encryption == "" {
+		user["encryption"] = "none"
+	}
+	stream := object{"network": "tcp", "security": "none"}
+	if o.Multiplex != nil && o.Multiplex.Enabled {
+		return nil, fmt.Errorf("legacy sing-box multiplex is not an Xray protocol; reimport the original VLESS link")
+	}
+	if t := o.TLS; t != nil && t.Enabled {
+		tls := object{"serverName": t.ServerName, "allowInsecure": t.Insecure, "alpn": t.ALPN}
+		if t.UTLS != nil && t.UTLS.Enabled {
+			tls["fingerprint"] = t.UTLS.Fingerprint
+		}
+		security := "tls"
+		if t.Reality != nil && t.Reality.Enabled {
+			security = "reality"
+			tls["publicKey"] = t.Reality.PublicKey
+			tls["shortId"] = t.Reality.ShortID
+		}
+		if t.DisableSNI || len(t.Certificate) > 0 || t.CertificatePath != "" ||
+			len(t.CertificatePublicKeySHA256) > 0 || t.ECH != nil || len(t.ClientCertificate) > 0 || t.ClientCertificatePath != "" {
+			return nil, fmt.Errorf("legacy VLESS TLS extensions require the original VLESS link or native Xray configuration")
+		}
+		if t.MinVersion != "" {
+			tls["minVersion"] = t.MinVersion
+		}
+		if t.MaxVersion != "" {
+			tls["maxVersion"] = t.MaxVersion
+		}
+		stream["security"] = security
+		stream[security+"Settings"] = tls
+	}
+	if t := o.Transport; t != nil {
+		var settings object
+		switch t.Type {
+		case "ws":
+			settings = object{"path": t.WebsocketOptions.Path, "headers": t.WebsocketOptions.Headers.Build()}
+		case "httpupgrade":
+			settings = object{"path": t.HTTPUpgradeOptions.Path, "host": t.HTTPUpgradeOptions.Host}
+		case "grpc":
+			settings = object{"serviceName": t.GRPCOptions.ServiceName}
+		case "xhttp":
+			data, err := json.Marshal(t)
+			if err != nil {
+				return nil, err
+			}
+			var legacy object
+			if err = json.Unmarshal(data, &legacy); err != nil {
+				return nil, err
+			}
+			settings = object{}
+			for key, value := range legacy {
+				if key == "type" {
+					continue
+				}
+				pieces := strings.Split(key, "_")
+				for i := 1; i < len(pieces); i++ {
+					if pieces[i] != "" {
+						pieces[i] = strings.ToUpper(pieces[i][:1]) + pieces[i][1:]
+					}
+				}
+				settings[strings.Join(pieces, "")] = value
+			}
+		default:
+			return nil, fmt.Errorf("legacy VLESS transport %s requires the original link", t.Type)
+		}
+		stream["network"] = t.Type
+		stream[t.Type+"Settings"] = settings
+	}
+	return vlessOutbound(o.Server, int(o.ServerPort), user, stream), nil
+}
