diff --git a/protocol/hysteria2/tcp_conn.go b/protocol/hysteria2/tcp_conn.go
new file mode 100644
index 00000000..53c3874e
--- /dev/null
+++ b/protocol/hysteria2/tcp_conn.go
@@ -0,0 +1,88 @@
+package hysteria2
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+
+	hyclient "github.com/apernet/hysteria/core/v2/client"
+	"github.com/apernet/quic-go"
+)
+
+// HTTP/3 H3_NO_ERROR, the code the official client uses when closing its QUIC
+// connection (Client.Close and reconnects).
+const connectionCloseOK quic.ApplicationErrorCode = 0x100
+
+// dialTCP opens a Hysteria2 TCP stream without letting a stalled handshake or
+// stream open outlive ctx. The official client API takes no context, so the call
+// runs in its own goroutine; when ctx wins, a connection that is established
+// later is closed instead of leaked.
+func dialTCP(ctx context.Context, client hyclient.Client, address string) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	type result struct {
+		conn net.Conn
+		err  error
+	}
+	done := make(chan result, 1)
+	go func() {
+		conn, err := client.TCP(address)
+		done <- result{conn, err}
+	}()
+	select {
+	case r := <-done:
+		if r.err != nil {
+			return nil, r.err
+		}
+		return &tcpConn{Conn: r.conn}, nil
+	case <-ctx.Done():
+		go func() {
+			if r := <-done; r.conn != nil {
+				_ = r.conn.Close()
+			}
+		}()
+		return nil, ctx.Err()
+	}
+}
+
+// tcpConn maps the benign teardown errors of QUIC streams to net.ErrClosed so
+// sing-box (E.IsClosedOrCanceled) treats them as an ordinary close instead of
+// logging "connection download closed: stream N canceled by local with error
+// code 0". The official QStream.Close() calls CancelRead(0), which fails a
+// concurrent Read with a local StreamError.
+//
+// The official connection implements only net.Conn (no ReadWaiter, EarlyConn or
+// Upstream), so this wrapper loses no zero-copy path. It deliberately has no
+// Upstream() either, so sing-box cannot unwrap it and bypass the mapping.
+type tcpConn struct{ net.Conn }
+
+func (c *tcpConn) Read(buffer []byte) (int, error) {
+	n, err := c.Conn.Read(buffer)
+	return n, normalizeCloseError(err)
+}
+
+func (c *tcpConn) Write(buffer []byte) (int, error) {
+	n, err := c.Conn.Write(buffer)
+	return n, normalizeCloseError(err)
+}
+
+// normalizeCloseError reports errors that only mean "the stream or the QUIC
+// connection was closed on purpose" as net.ErrClosed, keeping the original as a
+// second wrapped cause. Types are matched with errors.As, never by message.
+func normalizeCloseError(err error) error {
+	if err == nil || errors.Is(err, net.ErrClosed) {
+		return err
+	}
+	var streamError *quic.StreamError
+	if errors.As(err, &streamError) && streamError.ErrorCode == 0 {
+		return fmt.Errorf("%w: %w", net.ErrClosed, err)
+	}
+	var applicationError *quic.ApplicationError
+	if errors.As(err, &applicationError) &&
+		(!applicationError.Remote || applicationError.ErrorCode == 0 || applicationError.ErrorCode == connectionCloseOK) {
+		return fmt.Errorf("%w: %w", net.ErrClosed, err)
+	}
+	return err
+}
