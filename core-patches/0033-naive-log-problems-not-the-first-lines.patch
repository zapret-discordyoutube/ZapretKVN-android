+// The flaw of core patch 0032: it logged "the first 200 lines" at info level, and the client writes about two lines per
+// connection, so a healthy session in use spent that budget in minutes and a failure that came later was invisible.
+func TestAFailureAfterALongHealthySessionIsStillSeen(t *testing.T) {
+	var text strings.Builder
+	text.WriteString("[1127/144157.474837:INFO:net/tools/naive/naive_proxy_bin.cc:549] Listening on socks://127.0.0.1:20150\n")
+	for i := 0; i < 2000; i++ {
+		fmt.Fprintf(&text, "[1127/144200.451683:INFO:net/tools/naive/naive_connection.cc:286] Connection %d to example.com:443 via HTTPS proxy.example:443\n", i)
+		fmt.Fprintf(&text, "[1127/144200.451825:INFO:net/tools/naive/naive_proxy.cc:288] Connection %d closed: OK\n", i)
+	}
+	text.WriteString("[1127/151012.000001:WARNING:net/tools/naive/naive_proxy.cc:193] Preamble error: ERR_PROXY_CONNECTION_FAILED\n")
+	text.WriteString("[1127/151012.000002:INFO:net/tools/naive/naive_proxy.cc:288] Connection 2001 closed: ERR_CONNECTION_RESET\n")
+	got := run(text.String(), nil)
+	if len(got.info) != childStartupLines {
+		t.Fatalf("ordinary lines must stop at the startup budget, got %d info lines", len(got.info))
+	}
+	if len(got.warn) != 2 || !strings.Contains(got.warn[0], "ERR_PROXY_CONNECTION_FAILED") || !strings.Contains(got.warn[1], "ERR_CONNECTION_RESET") {
+		t.Fatalf("the late failure must reach the warn log, got %v", got.warn)
+	}
+	if len(got.debug) != 4001-childStartupLines {
+		t.Fatalf("the healthy chatter after the budget goes to debug, got %d lines", len(got.debug))
+	}
+}
