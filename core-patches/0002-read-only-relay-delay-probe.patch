+func (c *CommandClient) ProbeOutboundRelayDelays(groupTag string, handler RelayDelayProbeHandler) error {
+	if handler == nil {
+		return E.New("missing relay delay probe handler")
+	}
+	_, err := callWithResult(c, func(ctx context.Context, client daemon.StartedServiceClient) (*emptypb.Empty, error) {
+		stream, err := client.ProbeOutboundRelayDelays(ctx, &daemon.RelayDelayProbeRequest{
+			GroupTag: groupTag,
+		})
+		if err != nil {
+			return nil, err
+		}
+		for {
+			result, receiveErr := stream.Recv()
+			if receiveErr == io.EOF {
+				return &emptypb.Empty{}, nil
+			}
+			if receiveErr != nil {
+				return nil, receiveErr
+			}
+			handler.WriteRelayDelay(&RelayDelayProbeResult{
+				OutboundTag:        result.OutboundTag,
+				Outcome:            int32(result.Outcome),
+				DelayMillis:        result.DelayMillis,
+				TestedAtUnixMillis: result.TestedAtUnixMillis,
+			})
+		}
+	})
+	return err
+}
