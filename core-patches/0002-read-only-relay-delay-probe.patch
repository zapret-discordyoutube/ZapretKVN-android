diff --git a/daemon/started_service_relay_probe_test.go b/daemon/started_service_relay_probe_test.go
new file mode 100644
index 00000000..5faeaeba
--- /dev/null
+++ b/daemon/started_service_relay_probe_test.go
@@ -0,0 +1,157 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestProbeOutboundRelayDelayRejectsNestedGroupWithoutDial(t *testing.T) {
+	result := probeOutboundRelayDelay(context.Background(), relayDelayProbeTarget{
+		tag:         "nested",
+		unsupported: true,
+	})
+	if result.OutboundTag != "nested" {
+		t.Fatalf("unexpected tag: %q", result.OutboundTag)
+	}
+	if result.Outcome != RelayDelayProbeResult_UNSUPPORTED {
+		t.Fatalf("unexpected outcome: %s", result.Outcome)
+	}
+	if result.DelayMillis != 0 {
+		t.Fatalf("unsupported target returned delay: %d", result.DelayMillis)
+	}
+}
+
+func TestRelayDelayProbeOutcome(t *testing.T) {
+	failed := errors.New("dial failed")
+	for _, test := range []struct {
+		name       string
+		err        error
+		contextErr error
+		want       RelayDelayProbeResult_Outcome
+	}{
+		{name: "success", want: RelayDelayProbeResult_SUCCESS},
+		{name: "timeout error", err: context.DeadlineExceeded, want: RelayDelayProbeResult_TIMEOUT},
+		{name: "timeout context", err: failed, contextErr: context.DeadlineExceeded, want: RelayDelayProbeResult_TIMEOUT},
+		{name: "failure", err: failed, want: RelayDelayProbeResult_FAILED},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := relayDelayProbeOutcome(test.err, test.contextErr); got != test.want {
+				t.Fatalf("outcome = %s, want %s", got, test.want)
+			}
+		})
+	}
+}
+
+func TestStreamRelayDelayProbeResultsSingleton(t *testing.T) {
+	var received []*RelayDelayProbeResult
+	err := streamRelayDelayProbeResults(
+		context.Background(),
+		[]relayDelayProbeTarget{{tag: "only"}},
+		func(result *RelayDelayProbeResult) error {
+			received = append(received, result)
+			return nil
+		},
+		func(_ context.Context, target relayDelayProbeTarget) *RelayDelayProbeResult {
+			return &RelayDelayProbeResult{
+				OutboundTag: target.tag,
+				Outcome:     RelayDelayProbeResult_SUCCESS,
+				DelayMillis: 7,
+			}
+		},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(received) != 1 || received[0].OutboundTag != "only" || received[0].DelayMillis != 7 {
+		t.Fatalf("unexpected singleton stream: %+v", received)
+	}
+}
+
+func TestStreamRelayDelayProbeResultsLimitsConcurrencyAndStreamsEveryTarget(t *testing.T) {
+	targets := make([]relayDelayProbeTarget, 25)
+	for index := range targets {
+		targets[index].tag = fmt.Sprintf("outbound-%02d", index)
+	}
+	entered := make(chan struct{}, len(targets))
+	release := make(chan struct{}, len(targets))
+	var current atomic.Int32
+	var maximum atomic.Int32
+	var received atomic.Int32
+	done := make(chan error, 1)
+	go func() {
+		done <- streamRelayDelayProbeResults(
+			context.Background(),
+			targets,
+			func(*RelayDelayProbeResult) error {
+				received.Add(1)
+				return nil
+			},
+			func(_ context.Context, target relayDelayProbeTarget) *RelayDelayProbeResult {
+				now := current.Add(1)
+				for {
+					prior := maximum.Load()
+					if now <= prior || maximum.CompareAndSwap(prior, now) {
+						break
+					}
+				}
+				entered <- struct{}{}
+				<-release
+				current.Add(-1)
+				return &RelayDelayProbeResult{OutboundTag: target.tag}
+			},
+		)
+	}()
+	for range relayDelayProbeConcurrency {
+		<-entered
+	}
+	select {
+	case <-entered:
+		t.Fatal("more than ten probes entered before a worker was released")
+	case <-time.After(25 * time.Millisecond):
+	}
+	for range targets {
+		release <- struct{}{}
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if maximum.Load() != relayDelayProbeConcurrency {
+		t.Fatalf("maximum concurrency = %d, want %d", maximum.Load(), relayDelayProbeConcurrency)
+	}
+	if received.Load() != int32(len(targets)) {
+		t.Fatalf("received %d results, want %d", received.Load(), len(targets))
+	}
+}
+
+func TestStreamRelayDelayProbeResultsCancellationStopsQueue(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	targets := make([]relayDelayProbeTarget, 20)
+	started := make(chan struct{}, len(targets))
+	done := make(chan error, 1)
+	go func() {
+		done <- streamRelayDelayProbeResults(
+			ctx,
+			targets,
+			func(*RelayDelayProbeResult) error { return nil },
+			func(ctx context.Context, _ relayDelayProbeTarget) *RelayDelayProbeResult {
+				started <- struct{}{}
+				<-ctx.Done()
+				return &RelayDelayProbeResult{}
+			},
+		)
+	}()
+	for range relayDelayProbeConcurrency {
+		<-started
+	}
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation error = %v, want context.Canceled", err)
+	}
+	if len(started) != 0 {
+		t.Fatalf("queue started %d additional probes after cancellation", len(started))
+	}
+}
