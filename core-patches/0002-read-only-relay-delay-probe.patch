+const relayDelayProbeConcurrency = 10
+const relayDelayProbeURL = "https://www.gstatic.com/generate_204"
+
+type relayDelayProbeTarget struct {
+	tag         string
+	outbound    adapter.Outbound
+	unsupported bool
+}
+
+// ProbeOutboundRelayDelays measures each leaf outbound without mutating URL-test
+// history, group selection, or active connections.
+func (s *StartedService) ProbeOutboundRelayDelays(
+	request *RelayDelayProbeRequest,
+	server grpc.ServerStreamingServer[RelayDelayProbeResult],
+) error {
+	s.serviceAccess.RLock()
+	if s.serviceStatus.Status != ServiceStatus_STARTED {
+		s.serviceAccess.RUnlock()
+		return os.ErrInvalid
+	}
+	boxService := s.instance
+	s.serviceAccess.RUnlock()
+
+	abstractGroup, loaded := boxService.instance.Outbound().Outbound(request.GroupTag)
+	if !loaded {
+		return E.New("outbound group not found: ", request.GroupTag)
+	}
+	outboundGroup, isGroup := abstractGroup.(adapter.OutboundGroup)
+	if !isGroup {
+		return E.New("outbound is not a group: ", request.GroupTag)
+	}
+
+	targets := make([]relayDelayProbeTarget, 0, len(outboundGroup.All()))
+	for _, tag := range outboundGroup.All() {
+		outbound, exists := boxService.instance.Outbound().Outbound(tag)
+		if !exists {
+			targets = append(targets, relayDelayProbeTarget{tag: tag, unsupported: true})
+			continue
+		}
+		_, nestedGroup := outbound.(adapter.OutboundGroup)
+		targets = append(targets, relayDelayProbeTarget{
+			tag:         tag,
+			outbound:    outbound,
+			unsupported: nestedGroup,
+		})
+	}
+
+	ctx, cancel := context.WithCancel(server.Context())
+	stopServiceCancellation := context.AfterFunc(s.ctx, cancel)
+	defer func() {
+		stopServiceCancellation()
+		cancel()
+	}()
+
+	return streamRelayDelayProbeResults(ctx, targets, server.Send, probeOutboundRelayDelay)
+}
+
+type relayDelayProbeFunc func(context.Context, relayDelayProbeTarget) *RelayDelayProbeResult
+
+func streamRelayDelayProbeResults(
+	ctx context.Context,
+	targets []relayDelayProbeTarget,
+	send func(*RelayDelayProbeResult) error,
+	probe relayDelayProbeFunc,
+) error {
+	if len(targets) == 0 {
+		return ctx.Err()
+	}
+	workerContext, cancelWorkers := context.WithCancel(ctx)
+	defer cancelWorkers()
+	jobs := make(chan relayDelayProbeTarget)
+	results := make(chan *RelayDelayProbeResult, relayDelayProbeConcurrency)
+	workerCount := min(relayDelayProbeConcurrency, len(targets))
+	var workers sync.WaitGroup
+	workers.Add(workerCount)
+	for range workerCount {
+		go func() {
+			defer workers.Done()
+			for target := range jobs {
+				if workerContext.Err() != nil {
+					return
+				}
+				result := probe(workerContext, target)
+				if workerContext.Err() != nil {
+					return
+				}
+				select {
+				case results <- result:
+				case <-workerContext.Done():
+					return
+				}
+			}
+		}()
+	}
+	go func() {
+		defer close(jobs)
+		for _, target := range targets {
+			if workerContext.Err() != nil {
+				return
+			}
+			select {
+			case jobs <- target:
+			case <-workerContext.Done():
+				return
+			}
+		}
+	}()
+	go func() {
+		workers.Wait()
+		close(results)
+	}()
+
+	for result := range results {
+		if err := send(result); err != nil {
+			return err
+		}
+	}
+	return ctx.Err()
+}
+
+func probeOutboundRelayDelay(ctx context.Context, target relayDelayProbeTarget) *RelayDelayProbeResult {
+	result := &RelayDelayProbeResult{
+		OutboundTag:        target.tag,
+		Outcome:            RelayDelayProbeResult_UNSUPPORTED,
+		TestedAtUnixMillis: time.Now().UnixMilli(),
+	}
+	if target.unsupported || target.outbound == nil {
+		return result
+	}
+	testContext, cancel := context.WithTimeout(ctx, C.TCPTimeout)
+	delay, err := urltest.URLTest(testContext, relayDelayProbeURL, target.outbound)
+	cancel()
+	result.TestedAtUnixMillis = time.Now().UnixMilli()
+	result.Outcome = relayDelayProbeOutcome(err, testContext.Err())
+	if result.Outcome == RelayDelayProbeResult_SUCCESS {
+		result.DelayMillis = int32(delay)
+	}
+	return result
+}
+
+func relayDelayProbeOutcome(err error, contextErr error) RelayDelayProbeResult_Outcome {
+	if err == nil {
+		return RelayDelayProbeResult_SUCCESS
+	}
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(contextErr, context.DeadlineExceeded) {
+		return RelayDelayProbeResult_TIMEOUT
+	}
+	return RelayDelayProbeResult_FAILED
+}
