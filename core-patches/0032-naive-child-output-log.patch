+// childInfoLines is how many lines of one naive process are logged at info level.
+const childInfoLines = 200
+
+// logChildOutput logs the stock client's own messages (a refused proxy login, a certificate error, a failed resolve):
+// they are the only evidence when a naive key does not connect, so the first lines of every process go to the info log
+// and show in the app. The rest go to debug, so a noisy session cannot flood the log. The credentials are masked.
+func logChildOutput(reader io.Reader, secrets []string, info, debug func(args ...any)) {
+	shown := 0
+	scanner := bufio.NewScanner(reader)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" {
+			continue
+		}
+		for _, secret := range secrets {
+			if len(secret) >= 4 {
+				line = strings.ReplaceAll(line, secret, "<hidden>")
+			}
+		}
+		if shown < childInfoLines {
+			shown++
+			info("naive: ", line)
+			if shown == childInfoLines {
+				info("naive: the next messages of this process are logged at debug level")
+			}
+			continue
+		}
+		debug("naive: ", line)
+	}
+}
