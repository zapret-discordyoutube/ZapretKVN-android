diff --git a/protocol/hysteria2/tunnel_stats.go b/protocol/hysteria2/tunnel_stats.go
new file mode 100644
index 00000000..62349c50
--- /dev/null
+++ b/protocol/hysteria2/tunnel_stats.go
@@ -0,0 +1,105 @@
+package hysteria2
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"time"
+	"unsafe"
+
+	hyclient "github.com/apernet/hysteria/core/v2/client"
+	"github.com/apernet/quic-go"
+)
+
+// quicConnOf достаёт QUIC-соединение туннеля из клиента Hysteria. Клиент его не отдаёт, поэтому читается
+// закрытое поле: у переподключаемой обёртки это `client` (а в нём `*clientImpl` с полем `conn`). Вызывать
+// только из обратного вызова подключения: там замок обёртки уже держится, и поле читается без гонки.
+// Любое несоответствие раскладки (новая версия Hysteria) даёт ошибку, а не панику: статистика просто пропадает.
+func quicConnOf(client hyclient.Client) (conn *quic.Conn, err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			conn, err = nil, fmt.Errorf("unexpected hysteria client layout: %v", recovered)
+		}
+	}()
+	value := reflect.ValueOf(client)
+	if value.Kind() != reflect.Pointer || value.IsNil() {
+		return nil, errors.New("hysteria client is not a pointer")
+	}
+	value = value.Elem()
+	if inner := value.FieldByName("client"); inner.IsValid() {
+		inner = reflect.NewAt(inner.Type(), unsafe.Pointer(inner.UnsafeAddr())).Elem()
+		value = reflect.ValueOf(inner.Interface())
+		if value.Kind() != reflect.Pointer || value.IsNil() {
+			return nil, errors.New("inner hysteria client is not connected")
+		}
+		value = value.Elem()
+	}
+	field := value.FieldByName("conn")
+	if !field.IsValid() {
+		return nil, errors.New("hysteria client has no conn field")
+	}
+	pointer := reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem().Interface()
+	conn, ok := pointer.(*quic.Conn)
+	if !ok || conn == nil {
+		return nil, errors.New("conn field is not a QUIC connection")
+	}
+	return conn, nil
+}
+
+// TunnelStats — одна строка о QUIC-соединении туннеля: задержка и потери за время с прошлого вызова. Вызывается
+// приложением в момент его отсчёта трафика, таймера внутри ядра нет (экран выключен: телефон не будим).
+func (h *Outbound) TunnelStats() string {
+	conn := h.tunnelConn.Load()
+	if conn == nil || conn.Context().Err() != nil {
+		return ""
+	}
+	current := conn.ConnectionStats()
+	now := time.Now()
+	h.statsAccess.Lock()
+	previous, previousAt, same := h.statsPrevious, h.statsPreviousAt, h.statsPreviousConn == conn
+	h.statsPrevious, h.statsPreviousAt, h.statsPreviousConn = current, now, conn
+	h.statsAccess.Unlock()
+	return h.Tag() + ": " + formatTunnelStats(previous, same, current, now.Sub(previousAt))
+}
+
+func formatTunnelStats(previous quic.ConnectionStats, hasPrevious bool, current quic.ConnectionStats, window time.Duration) string {
+	text := fmt.Sprintf("tunnel quic: rtt min=%s latest=%s smoothed=%s dev=%s; total sent %d pkts %s, recv %d pkts %s, lost %d pkts",
+		current.MinRTT.Round(time.Millisecond), current.LatestRTT.Round(time.Millisecond),
+		current.SmoothedRTT.Round(time.Millisecond), current.MeanDeviation.Round(time.Millisecond),
+		current.PacketsSent, humanBytes(current.BytesSent), current.PacketsReceived, humanBytes(current.BytesReceived), current.PacketsLost)
+	if !hasPrevious || window <= 0 {
+		return text
+	}
+	sent := deltaUint(current.PacketsSent, previous.PacketsSent)
+	received := deltaUint(current.PacketsReceived, previous.PacketsReceived)
+	lost := deltaUint(current.PacketsLost, previous.PacketsLost)
+	percent := 0.0
+	if sent > 0 {
+		percent = float64(lost) * 100 / float64(sent)
+	}
+	seconds := window.Seconds()
+	return text + fmt.Sprintf("; last %.1fs: sent %d pkts %s (%s/s), recv %d pkts %s (%s/s), lost %d (%.2f%% of sent)",
+		seconds,
+		sent, humanBytes(deltaUint(current.BytesSent, previous.BytesSent)), humanBytes(uint64(float64(deltaUint(current.BytesSent, previous.BytesSent))/seconds)),
+		received, humanBytes(deltaUint(current.BytesReceived, previous.BytesReceived)), humanBytes(uint64(float64(deltaUint(current.BytesReceived, previous.BytesReceived))/seconds)),
+		lost, percent)
+}
+
+// deltaUint: PacketsLost не монотонен (потерянный пакет может прийти позже), поэтому отрицательное приращение это 0.
+func deltaUint(current uint64, previous uint64) uint64 {
+	if current < previous {
+		return 0
+	}
+	return current - previous
+}
+
+func humanBytes(value uint64) string {
+	switch {
+	case value < 1024:
+		return fmt.Sprintf("%dB", value)
+	case value < 1024*1024:
+		return fmt.Sprintf("%.0fKB", float64(value)/1024)
+	default:
+		return fmt.Sprintf("%.1fMB", float64(value)/(1024*1024))
+	}
+}
