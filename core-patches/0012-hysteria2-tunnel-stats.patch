+// TunnelStatsText — по строке статистики QUIC-соединения туннеля на каждый исходящий узел, который её умеет
+// (Hysteria2). Пусто, если соединений ещё нет. Ошибка вместо флага: gobind принимает только второй результат error.
+func (s *StartedService) TunnelStatsText() (string, error) {
+	s.serviceAccess.RLock()
+	nowService := s.instance
+	s.serviceAccess.RUnlock()
+	if nowService == nil || nowService.outboundManager == nil {
+		return "", E.New("service is not started")
+	}
+	var lines []string
+	for _, outbound := range nowService.outboundManager.Outbounds() {
+		if reporter, loaded := outbound.(interface{ TunnelStats() string }); loaded {
+			if line := reporter.TunnelStats(); line != "" {
+				lines = append(lines, line)
+			}
+		}
+	}
+	return strings.Join(lines, "\n"), nil
+}
