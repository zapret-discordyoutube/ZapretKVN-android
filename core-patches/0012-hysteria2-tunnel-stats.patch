+package hysteria2
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	hyclient "github.com/apernet/hysteria/core/v2/client"
+	hyserver "github.com/apernet/hysteria/core/v2/server"
+	"github.com/apernet/quic-go"
+)
+
+type staticAuth struct{}
+
+func (staticAuth) Authenticate(net.Addr, string, uint64) (bool, string) { return true, "test" }
+
+type udpFactory struct{}
+
+func (udpFactory) New(net.Addr) (net.PacketConn, error) {
+	return net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+}
+
+func selfSignedCertificate(t *testing.T) tls.Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "localhost"}, DNSNames: []string{"localhost"},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// Настоящий сервер и клиент Hysteria в одном процессе: доказывает, что обратный вызов подключения достаёт
+// QUIC-соединение туннеля через закрытые поля, и что статистика после обмена не пуста.
+func TestQuicConnOfReachesTheTunnelConnectionOfARealClient(t *testing.T) {
+	serverConn, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := hyserver.NewServer(&hyserver.Config{
+		TLSConfig:     hyserver.TLSConfig{Certificates: []tls.Certificate{selfSignedCertificate(t)}},
+		Conn:          serverConn,
+		Authenticator: staticAuth{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() { _ = server.Serve() }()
+	defer server.Close()
+
+	var found *quic.Conn
+	var foundErr error
+	client, err := hyclient.NewReconnectableClient(func() (*hyclient.Config, error) {
+		return &hyclient.Config{
+			ConnFactory: udpFactory{},
+			ServerAddr:  serverConn.LocalAddr(),
+			Auth:        "password",
+			TLSConfig:   hyclient.TLSConfig{ServerName: "localhost", InsecureSkipVerify: true},
+		}, nil
+	}, func(connected hyclient.Client, _ *hyclient.HandshakeInfo, _ int) {
+		found, foundErr = quicConnOf(connected)
+	}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if foundErr != nil || found == nil {
+		t.Fatalf("quicConnOf failed: %v", foundErr)
+	}
+	stats := found.ConnectionStats()
+	if stats.PacketsSent == 0 || stats.PacketsReceived == 0 {
+		t.Fatalf("the handshake must have moved packets both ways: %+v", stats)
+	}
+	if text := formatTunnelStats(stats, false, stats, time.Second); !strings.Contains(text, "tunnel quic: rtt") {
+		t.Fatalf("unexpected text %q", text)
+	}
+}
+
+func TestQuicConnOfRejectsUnknownLayouts(t *testing.T) {
+	if _, err := quicConnOf(nil); err == nil {
+		t.Fatal("nil client must be an error")
+	}
+	type notAClient struct{ hyclient.Client }
+	if _, err := quicConnOf(&notAClient{}); err == nil {
+		t.Fatal("a foreign layout must be an error, not a panic")
+	}
+}
+
+func TestFormatTunnelStatsReportsTheWindowAndNeverGoesNegative(t *testing.T) {
+	previous := quic.ConnectionStats{PacketsSent: 1000, PacketsReceived: 2000, BytesSent: 1_000_000, BytesReceived: 2_500_000, PacketsLost: 50}
+	current := quic.ConnectionStats{
+		MinRTT: 78 * time.Millisecond, LatestRTT: 91 * time.Millisecond, SmoothedRTT: 85 * time.Millisecond, MeanDeviation: 9 * time.Millisecond,
+		PacketsSent: 1100, PacketsReceived: 2900, BytesSent: 1_100_000, BytesReceived: 3_400_000,
+		PacketsLost: 40, // потерянный пакет пришёл позже: счётчик пошёл назад
+	}
+	text := formatTunnelStats(previous, true, current, 5*time.Second)
+	for _, want := range []string{"rtt min=78ms latest=91ms smoothed=85ms dev=9ms", "last 5.0s: sent 100 pkts", "recv 900 pkts", "lost 0 (0.00% of sent)"} {
+		if !strings.Contains(text, want) {
+			t.Errorf("%q missing in %q", want, text)
+		}
+	}
+	if without := formatTunnelStats(previous, false, current, 5*time.Second); strings.Contains(without, "last ") {
+		t.Errorf("no window text without a previous sample: %q", without)
+	}
+}
